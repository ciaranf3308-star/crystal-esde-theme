        <view name="gamelist">
        <!-- v9.0.0: full layout rebuild from the user's wireframe direction
             (2026-09-21). The v8 horizontal media row is rejected; the new
             composition is:
               - large left information panel (white, rounded, soft shadow):
                 marquee header (full opacity, designed element), yellow
                 accent rule, stacked metadata (description, year, genre,
                 players, developer, rating), screenshot in a rounded box
                 near the bottom
               - vertical console-name branding rail between panel and hero
                 (pre-rendered per-system art via ${system.name}, reads
                 bottom-to-top, navy gradient + yellow spine)
               - giant selected physical-media hero on the right: VERTICAL
                 carousel, selected 520px at (900,430), neighbours 180px at
                 (900,10)/(900,850) clipped at the screen edges, dimmed
               - yellow rim glow + blue halo + contact shadow on the hero
               - game title beneath the hero, footer kept.
             Verified against ES-DE v3.4.1: vertical carousel pitch =
             element height / maxItemCount = 1260/3 = 420px; scissor clips
             the partially off-screen neighbours exactly like the wireframe.
             Motion: native eased carousel transitions only. -->

        <!-- 1. Supplied universal Nova library background, full-bleed. -->
        <image name="libBackground">
            <pos>0 0</pos>
            <size>1 1</size>
            <origin>0 0</origin>
            <path>./art/gamelist_generic_bg.png</path>
            <zIndex>1</zIndex>
        </image>

        <!-- 2. Bottom contrast: transparent -> deep navy from y 690 down. -->
        <image name="libBottomGradient">
            <pos>0 0.71875</pos>
            <size>1 0.28125</size>
            <origin>0 0</origin>
            <path>./art/lib_bottom_gradient.png</path>
            <zIndex>2</zIndex>
        </image>

        <!-- 3. LEFT PANEL: white rounded card, 6,10 480x940 (interior
             24..468 x 24..936). Soft shadow baked into the asset. -->
        <image name="libPanel">
            <pos>0.0046875 0.0104167</pos>
            <size>0.375 0.9791667</size>
            <origin>0 0</origin>
            <path>./art/lib_panel.png</path>
            <zIndex>10</zIndex>
        </image>

        <!-- 4. CONSOLE RAIL: 486,24 76x912. Per-system pre-rendered art
             (navy gradient, yellow spine, vertical name) via
             ${system.name} substitution - no per-system XML needed. -->
        <image name="libRail">
            <pos>0.3796875 0.025</pos>
            <size>0.059375 0.95</size>
            <origin>0 0</origin>
            <path>./art/rails/${system.name}.png</path>
            <zIndex>10</zIndex>
        </image>

        <!-- 5. PANEL CONTENTS. Marquee is a designed header element at full
             opacity, 56,56 380x170. Title fallback shows only when the
             marquee art is missing. -->
        <text name="libMarqueeTitle">
            <pos>0.04375 0.0583333</pos>
            <size>0.296875 0.1770833</size>
            <origin>0 0</origin>
            <metadata>name</metadata>
            <letterCase>uppercase</letterCase>
            <fontSize>0.027</fontSize>
            <color>${crystalDeep}</color>
            <opacity>0.6</opacity>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>19</zIndex>
        </text>
        <image name="libMarquee">
            <pos>0.04375 0.0583333</pos>
            <maxSize>0.296875 0.1770833</maxSize>
            <origin>0 0</origin>
            <imageType>marquee</imageType>
            <opacity>1.0</opacity>
            <zIndex>20</zIndex>
        </image>

        <!-- 6. Yellow accent rule under the marquee. -->
        <image name="libPanelRule">
            <pos>0.04375 0.25</pos>
            <size>0.09375 0.0041667</size>
            <origin>0 0</origin>
            <path>./art/lib_rule_yellow.png</path>
            <zIndex>20</zIndex>
        </image>

        <!-- 7. METADATA STACK: description, year, genre, players,
             developer, rating. Dark ink on the white panel. -->
        <text name="libDesc">
            <pos>0.04375 0.26875</pos>
            <size>0.296875 0.125</size>
            <origin>0 0</origin>
            <metadata>description</metadata>
            <fontSize>0.015625</fontSize>
            <color>${crystalInkDim}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <verticalAlignment>top</verticalAlignment>
            <zIndex>20</zIndex>
        </text>
        <datetime name="libYear">
            <pos>0.04375 0.40625</pos>
            <size>0.296875 0.0395833</size>
            <origin>0 0</origin>
            <metadata>releasedate</metadata>
            <format>%Y</format>
            <fontSize>0.03125</fontSize>
            <color>${crystalDeep}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <verticalAlignment>top</verticalAlignment>
            <zIndex>20</zIndex>
        </datetime>
        <text name="libGenre">
            <pos>0.04375 0.45</pos>
            <size>0.296875 0.0260417</size>
            <origin>0 0</origin>
            <metadata>genre</metadata>
            <letterCase>uppercase</letterCase>
            <fontSize>0.01875</fontSize>
            <color>${crystalDeep}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <verticalAlignment>top</verticalAlignment>
            <zIndex>20</zIndex>
        </text>
        <text name="libPlayers">
            <pos>0.04375 0.4791667</pos>
            <size>0.296875 0.0239583</size>
            <origin>0 0</origin>
            <metadata>players</metadata>
            <letterCase>uppercase</letterCase>
            <fontSize>0.0167</fontSize>
            <color>${crystalInkDim}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <verticalAlignment>top</verticalAlignment>
            <zIndex>20</zIndex>
        </text>
        <text name="libDev">
            <pos>0.04375 0.50625</pos>
            <size>0.296875 0.0239583</size>
            <origin>0 0</origin>
            <metadata>developer</metadata>
            <letterCase>uppercase</letterCase>
            <fontSize>0.0167</fontSize>
            <color>${crystalInkDim}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <verticalAlignment>top</verticalAlignment>
            <zIndex>20</zIndex>
        </text>
        <rating name="libRating">
            <pos>0.04375 0.5375</pos>
            <size>0.15 0.03125</size>
            <origin>0 0</origin>
            <filledPath>./art/star_filled.png</filledPath>
            <unfilledPath>./art/star_unfilled.png</unfilledPath>
            <hideIfZero>true</hideIfZero>
            <zIndex>20</zIndex>
        </rating>

        <!-- 8. SCREENSHOT in a rounded box near the panel bottom.
             libShotFrame is a white-cornered rounded border laid over the
             square screenshot, so the rounding is pixel-exact. -->
        <text name="libShotLabel">
            <pos>0.04375 0.6375</pos>
            <size>0.296875 0.0197917</size>
            <origin>0 0</origin>
            <text>SCREENSHOT</text>
            <letterCase>uppercase</letterCase>
            <fontSize>0.0135</fontSize>
            <color>${crystalInkDim}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>20</zIndex>
        </text>
        <image name="libScreenshot">
            <pos>0.04375 0.6666667</pos>
            <size>0.296875 0.2229167</size>
            <origin>0 0</origin>
            <imageType>image</imageType>
            <defaultImage>./media_fallbacks/${system.name}.png</defaultImage>
            <zIndex>20</zIndex>
        </image>
        <image name="libShotFrame">
            <pos>0.04375 0.6666667</pos>
            <size>0.296875 0.2229167</size>
            <origin>0 0</origin>
            <path>./art/lib_shot_frame.png</path>
            <zIndex>21</zIndex>
        </image>

        <!-- 9. HERO ATMOSPHERE at the selected slot (900,430), static.
             Blue halo, yellow rim (regenerated for the 520px disk, core
             r260), soft contact shadow. -->
        <image name="libSelectedGlowBlue">
            <pos>0.703125 0.4479167</pos>
            <size>0.5 0.6</size>
            <origin>0.5 0.5</origin>
            <path>./art/lib_glow_blue.png</path>
            <opacity>0.35</opacity>
            <zIndex>47</zIndex>
        </image>
        <image name="libSelectedGlow">
            <pos>0.703125 0.4479167</pos>
            <size>0.5 0.6666667</size>
            <origin>0.5 0.5</origin>
            <path>./art/lib_glow_yellow.png</path>
            <opacity>0.7</opacity>
            <zIndex>48</zIndex>
        </image>
        <image name="libSelectedShadow">
            <pos>0.703125 0.7145833</pos>
            <size>0.4375 0.0541667</size>
            <origin>0.5 0.5</origin>
            <path>./art/lib_shadow_soft.png</path>
            <opacity>0.75</opacity>
            <zIndex>49</zIndex>
        </image>

        <!-- 10. THE MEDIA COLUMN. Vertical carousel, element 640x1260
             centred at (900,430), maxItemCount 3 -> 420px pitch: previous
             at (900,10) clipped at the top edge, selected 520px at
             (900,430) (180px * 2.8889, the hero pulled forward), next at
             (900,850) clipped at the bottom edge. Neighbours dimmed so
             they read as support. -->
        <carousel name="gameCarousel">
            <type>vertical</type>
            <color>00000000</color>
            <pos>0.703125 0.4479167</pos>
            <size>0.5 1.3125</size>
            <origin>0.5 0.5</origin>
            <imageType>physicalmedia 3dbox</imageType>
            <defaultImage>./media_fallbacks/${system.name}.png</defaultImage>
            <itemSize>0.140625 0.1875</itemSize>
            <itemScale>2.8889</itemScale>
            <maxItemCount>3.0</maxItemCount>
            <itemsBeforeCenter>1</itemsBeforeCenter>
            <itemsAfterCenter>1</itemsAfterCenter>
            <itemHorizontalAlignment>center</itemHorizontalAlignment>
            <reflections>false</reflections>
            <unfocusedItemOpacity>0.75</unfocusedItemOpacity>
            <unfocusedItemSaturation>0.8</unfocusedItemSaturation>
            <unfocusedItemDimming>0.25</unfocusedItemDimming>
            <imageInterpolation>linear</imageInterpolation>
            <itemTransitions>animate</itemTransitions>
            <fastScrolling>true</fastScrolling>
            <zIndex>50</zIndex>
        </carousel>

        <!-- 11. TITLE beneath the hero: yellow rule at 716, 28px uppercase
             title centred on the hero column at 736. -->
        <image name="libTitleRule">
            <pos>0.703125 0.7458333</pos>
            <size>0.1875 0.0041667</size>
            <origin>0.5 0.5</origin>
            <path>./art/lib_rule_yellow.png</path>
            <zIndex>59</zIndex>
        </image>
        <text name="libGameName">
            <pos>0.703125 0.7666667</pos>
            <size>0.5 0.0375</size>
            <origin>0.5 0.5</origin>
            <metadata>name</metadata>
            <letterCase>uppercase</letterCase>
            <fontSize>0.029167</fontSize>
            <color>FFFFFF</color>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>

        <!-- 12. The footer row: one static line, the two genuinely useful
             actions, subdued. -->
        <text name="libFooter">
            <pos>0.5 0.953125</pos>
            <size>0.6 0.03</size>
            <origin>0.5 0.5</origin>
            <text>A PLAY &#8226; B BACK</text>
            <letterCase>uppercase</letterCase>
            <fontSize>0.016</fontSize>
            <color>A6FFFFFF</color>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>

        </view>
