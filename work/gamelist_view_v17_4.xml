        <!-- 10. THE MEDIA COLUMN. Vertical carousel, element 640x1440
             centred at (900,430), maxItemCount 3 -> 480px pitch: previous
             at (900,-50), 71% cropped off the top edge; selected 540px
             at (900,430) (240px * 2.25, the hero pulled forward); next
             at (900,910), 29% cropped off the bottom edge, pushed toward
             the lower-right corner and clear of the title zone. The
             real scraped physicalmedia keeps its native silhouette at
             every slot - no shape is forced into a disc treatment.
             Neighbours dimmed hard so they read as items in motion,
             subordinate to the hero. -->
        <carousel name="gameCarousel">
            <type>vertical</type>
            <color>00000000</color>
            <pos>0.703125 0.4479167</pos>
            <size>0.5 1.5</size>
            <origin>0.5 0.5</origin>
            <imageType>physicalmedia 3dbox</imageType>
            <defaultImage>./media_fallbacks/${system.name}.png</defaultImage>
            <itemSize>0.1875 0.25</itemSize>
            <itemScale>2.25</itemScale>
            <maxItemCount>3.0</maxItemCount>
            <itemsBeforeCenter>1</itemsBeforeCenter>
            <itemsAfterCenter>1</itemsAfterCenter>
            <itemHorizontalAlignment>center</itemHorizontalAlignment>
            <reflections>false</reflections>
            <unfocusedItemOpacity>0.45</unfocusedItemOpacity>
            <unfocusedItemSaturation>0.5</unfocusedItemSaturation>
            <unfocusedItemDimming>0.55</unfocusedItemDimming>
            <imageInterpolation>linear</imageInterpolation>
            <itemTransitions>animate</itemTransitions>
            <fastScrolling>true</fastScrolling>
            <zIndex>50</zIndex>
        </carousel>

