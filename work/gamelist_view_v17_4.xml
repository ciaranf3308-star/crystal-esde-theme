<view name="gamelist">
        <!-- v17.4.0 (2026-09-21): EDITORIAL SHELL pass. MACRO LAYOUT
             LOCKED (panel 6,10 470x940; spine 486,24 60x912; hero 540px
             at 900,430; rule Y716 / title Y736 / meta Y757; screenshot
             42,700 396x210; footer y915). Element positions/sizes are
             byte-identical to v17.3.0; what changes is the finish and
             the product concept: the shell is designed around REAL
             scraped artwork (98% of the library), and fallback hero art
             is deliberately plain.
               - MARQUEE: the navy card/frame is GONE (per user order:
                 "STOP PUTTING IT IN A GIANT BLUE BOX"). The marquee zone
                 is open white with generous negative space; the real
                 scraped marquee mounts directly on the page. No platform
                 tier - the spine already says the platform.
               - LEFT COLUMN: one editorial surface. Kickers optically
                 aligned to the value boxes, quieter slate; the single
                 description/facts hairline is the only structural rule.
               - SCREENSHOT: no "SCREENSHOT BOX" - bottom-edge hairline,
                 subtle depth, one yellow registration-mark corner.
               - SPINE: dot texture cut ~55%, halftone halved, connector
                 ticks removed (one continuous yellow line + top tab),
                 logo mounting plate given real breathing room.
               - TITLE: 0.0375 -> 0.040 (known-shipped v17.2 size) so the
                 display title stands up to the enormous media above it.
               - FALLBACKS: media_fallbacks rebuilt as flat muted
                 blue-grey silhouettes, one per media class - competent,
                 not spectacular, by design.
             Verified against ES-DE 3.4.1. No theme keyframes or idle
             animation exist or are claimed; carousel itemTransitions
             (animate) is the engine's only element motion and is engaged.
             The transition audit (esde_theme_tables.json) found no other
             supported motion property for text/image/datetime/rating. -->


        <!-- 1. Supplied universal Nova library background, full-bleed. -->
        <image name="libBackground">
            <pos>0 0</pos>
            <size>1 1</size>
            <origin>0 0</origin>
            <path>./art/gamelist_generic_bg.png</path>
            <zIndex>1</zIndex>
        </image>

        <!-- 2. Bottom contrast: transparent -> navy, local. -->
        <image name="libBottomGradient">
            <pos>0 0.71875</pos>
            <size>1 0.28125</size>
            <origin>0 0</origin>
            <path>./art/lib_bottom_gradient.png</path>
            <zIndex>2</zIndex>
        </image>

        <!-- 3. LEFT COLUMN: one editorial page (6,10 470x940). Open
             whitespace, typography and a few graphic rules - no mats, no
             frames, no nested boxes. Restrained craftsmanship only: tiny
             halftone transitions, one subtle blueprint fragment, one
             clipped blue geometric intrusion, sparse yellow micro-accents.
             The marquee and screenshot art land on the white page via the
             elements below. -->
        <image name="libPanelMain">
            <pos>0.0046875 0.0104167</pos>
            <size>0.3671875 0.9791667</size>
            <origin>0 0</origin>
            <path>./art/lib_panel_main.png</path>
            <zIndex>10</zIndex>
        </image>

        <!-- 4. CONSOLE SPINE: 486,24 60x912. Per-system art via
             ${system.name} (every system theme includes ../views.xml, so
             the binding is always the ACTUAL current system): royal
             gradient with subtle tonal variation, controlled grid
             texture, ONE continuous thin yellow structural line with
             small connector ticks, subtle halftone, supplied logo
             rotated 90deg CCW and deliberately MOUNTED on a mounting
             plate. -->
        <image name="libRail">
            <pos>0.3796875 0.025</pos>
            <size>0.046875 0.95</size>
            <origin>0 0</origin>
            <path>./art/rails/${system.name}.png</path>
            <zIndex>10</zIndex>
        </image>

        <!-- 5. MARQUEE, the visual headline of the page (24,44 424x252,
             +31% area over v15). Open whitespace - no mat, no frame, no
             blue rectangle, no fade. The fallback title shows only when
             the scraped marquee art is missing. -->
        <text name="libMarqueeTitle">
            <pos>0.01875 0.0458333</pos>
            <size>0.33125 0.2625</size>
            <origin>0 0</origin>
            <metadata>name</metadata>
            <letterCase>uppercase</letterCase>
            <fontPath>./fonts/PermanentMarker-Regular.ttf</fontPath>
            <fontSize>0.04</fontSize>
            <color>${crystalDeep}</color>
            <opacity>0.85</opacity>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>19</zIndex>
        </text>
        <image name="libMarquee">
            <pos>0.01875 0.0458333</pos>
            <maxSize>0.33125 0.2625</maxSize>
            <origin>0 0</origin>
            <imageType>marquee</imageType>
            <opacity>1.0</opacity>
            <zIndex>20</zIndex>
        </image>

