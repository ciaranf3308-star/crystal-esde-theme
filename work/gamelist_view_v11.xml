        <!-- 9. THE MEDIA COLUMN. Vertical carousel, element 640x1260
             centred at (900,430), maxItemCount 3 -> 420px pitch: previous
             at (900,10) cropped by the top edge, selected 520px at
             (900,430) (180px * 2.8889, the hero pulled forward), next at
             (900,850) cropped by the bottom edge. Neighbours dimmed hard
             so they read as objects entering/leaving the stage. -->
        <carousel name="gameCarousel">
            <type>vertical</type>
            <color>00000000</color>
            <pos>0.703125 0.4479167</pos>
            <size>0.5 1.3125</size>
            <origin>0.5 0.5</origin>
            <imageType>physicalmedia 3dbox</imageType>
            <defaultImage>./media_fallbacks/${system.name}.png</defaultImage>
            <itemSize>0.140625 0.1875</itemSize>
            <itemScale>2.8889</itemScale>
            <maxItemCount>3.0</maxItemCount>
            <itemsBeforeCenter>1</itemsBeforeCenter>
            <itemsAfterCenter>1</itemsAfterCenter>
            <itemHorizontalAlignment>center</itemHorizontalAlignment>
            <reflections>false</reflections>
            <unfocusedItemOpacity>0.55</unfocusedItemOpacity>
            <unfocusedItemSaturation>0.6</unfocusedItemSaturation>
            <unfocusedItemDimming>0.45</unfocusedItemDimming>
            <imageInterpolation>linear</imageInterpolation>
            <itemTransitions>animate</itemTransitions>
            <fastScrolling>true</fastScrolling>
            <zIndex>50</zIndex>
        </carousel>

