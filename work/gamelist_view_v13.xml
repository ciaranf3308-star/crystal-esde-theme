        <view name="gamelist">
        <!-- v13.0.0 (2026-09-21): PREMIUM POLISH pass on the approved
             skeleton. Base: the v12 mock. Regions preserved: left column
             (6,10 470x940), console spine (486,24, now 60px wide), hero
             540px at (900,430), prev (900,10) / next (900,850), pitch 420,
             title beneath hero (rule Y716 / title Y736 / meta Y757),
             screenshot lower-left, footer.
             What changed is the finish:
               - left column: same integrated module, de-boxed into a
                 Japanese-magazine editorial sidebar. No heavy nested
                 frames, no left-edge strip: royal header band (taller,
                 NOW SHOWING + yellow baseline), marquee on a clean white
                 mat with a royal L-frame and yellow corner tick (headline
                 block, not a box), editorial metadata with clean tracked
                 kickers, screenshot as a hairline-framed print with one
                 yellow tick. Fewer rules, more air.
               - central spine: thinner magazine spine (60px) - royal
                 gradient, ONE thin yellow separator line, small dot-grid
                 accents, supplied logos rotated 90deg CCW;
                 nes/psp/steam/windows/xbox360 keep clean text fallbacks.
               - hero: 540px (itemScale 3.0), asymmetric blue atmosphere,
                 tighter gold aura + LAYERED gold ring (outer hairline,
                 main band, inner light line, tight soft accent; all
                 transparent-cored - the v10 halo stays retired), clean
                 soft contact shadow. Clearly the focus.
               - neighbours: smaller (180px), dimmer (0.55/0.6/0.45),
                 edge-cropped real media; they sell the carousel, not the show.
               - title: bolder white marker face, wider double rule
                 (white hairline + yellow bar with a sweep head), plus a
                 refined short genre line beneath.
             Verified against ES-DE 3.4.1: vertical carousel pitch =
             element height / maxItemCount = 1260/3 = 420px; scissor clips
             the partially off-screen neighbours. Motion: native eased
             carousel transitions only - ES-DE has no theme keyframes or
             idle animation, so none is claimed. -->

        <!-- 1. Supplied universal Nova library background, full-bleed. -->
        <image name="libBackground">
            <pos>0 0</pos>
            <size>1 1</size>
            <origin>0 0</origin>
            <path>./art/gamelist_generic_bg.png</path>
            <zIndex>1</zIndex>
        </image>

        <!-- 2. Bottom contrast: transparent -> navy, local. -->
        <image name="libBottomGradient">
            <pos>0 0.71875</pos>
            <size>1 0.28125</size>
            <origin>0 0</origin>
            <path>./art/lib_bottom_gradient.png</path>
            <zIndex>2</zIndex>
        </image>

        <!-- 3. LEFT COLUMN: one integrated editorial module (6,10 470x940).
             The marquee and screenshot wells are punched transparent; the
             dynamic art lands on them via the elements below. -->
        <image name="libPanelMain">
            <pos>0.0046875 0.0104167</pos>
            <size>0.3671875 0.9791667</size>
            <origin>0 0</origin>
            <path>./art/lib_panel_main.png</path>
            <zIndex>10</zIndex>
        </image>

        <!-- 4. CONSOLE SPINE: 486,24 60x912. Per-system art via
             ${system.name}: royal gradient band, one thin yellow separator
             line, small dot-grid accents, supplied logo rotated 90deg CCW. -->
        <image name="libRail">
            <pos>0.3796875 0.025</pos>
            <size>0.046875 0.95</size>
            <origin>0 0</origin>
            <path>./art/rails/${system.name}.png</path>
            <zIndex>10</zIndex>
        </image>

        <!-- 5. MARQUEE, the headline block of the panel (36,74 404x188).
             Full opacity on the clean white mat; the text fallback shows
             only when the art is missing. -->
        <text name="libMarqueeTitle">
            <pos>0.028125 0.0770833</pos>
            <size>0.315625 0.1916667</size>
            <origin>0 0</origin>
            <metadata>name</metadata>
            <letterCase>uppercase</letterCase>
            <fontPath>./fonts/PermanentMarker-Regular.ttf</fontPath>
            <fontSize>0.032</fontSize>
            <color>${crystalDeep}</color>
            <opacity>0.85</opacity>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>19</zIndex>
        </text>
        <image name="libMarquee">
            <pos>0.028125 0.0770833</pos>
            <maxSize>0.315625 0.1916667</maxSize>
            <origin>0 0</origin>
            <imageType>marquee</imageType>
            <opacity>1.0</opacity>
            <zIndex>20</zIndex>
        </image>

        <!-- 6. METADATA: editorial order - description first, one large
