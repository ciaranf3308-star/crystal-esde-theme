<?xml version="1.0" encoding="UTF-8"?>
<theme>
    <!-- Crystal v4.0: 4:3 Nova layout. Text inherits the base panel
         positions from views.xml; only content and the measured name size
         are set here (DejaVu Sans Bold, title box 0.24). -->
    <include>./../variables.xml</include>
    <include>./../views.xml</include>
    <view name="system">
        <text name="mfrBadge">
            <text>NINTENDO</text>
        </text>
        <text name="sysName">
            <!-- base single-line name hidden: two-line name below -->
            <pos>-1 -1</pos>
        </text>
        <text name="sysName1">
            <!-- two-line name mirrors the baked graffiti title -->
            <pos>0.030 0.226</pos>
            <size>0.24 0.05</size>
            <fontSize>0.040</fontSize>
            <color>${crystalText}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>50</zIndex>
            <text>NINTENDO</text>
        </text>
        <text name="sysName2">
            <pos>0.030 0.266</pos>
            <size>0.24 0.036</size>
            <fontSize>0.022</fontSize>
            <color>${crystalText}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>50</zIndex>
            <text>ENTERTAINMENT SYSTEM</text>
        </text>
        <text name="sysDesc">
            <!-- panel threading: sits between this background's ruled lines -->
            <pos>0.030 0.305</pos>
            <text>The gray box that saved gaming. 8-bit legends.</text>
        </text>
        <text name="countNum">
            <pos>0.030 0.375</pos>
        </text>
        <text name="factsLine">
            <pos>0.030 0.440</pos>
            <text>8-BIT • 1985</text>
        </text>
    </view>
    <view name="gamelist">
        <!-- This system's background has no baked footer; live hints. -->
        <text name="footBadgeA">
            <pos>0.047 0.955</pos>
            <size>0.030 0.040</size>
            <origin>0.5 0.5</origin>
            <text>A</text>
            <fontSize>0.020</fontSize>
            <color>0A2FA0</color>
            <backgroundColor>FFFFFFFF</backgroundColor>
            <backgroundCornerRadius>0.5</backgroundCornerRadius>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>
        <text name="footWordA">
            <pos>0.072 0.955</pos>
            <origin>0 0.5</origin>
            <text>SELECT</text>
            <fontSize>0.016</fontSize>
            <color>FFFFFFFF</color>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>
        <text name="footBadgeB">
            <pos>0.129 0.955</pos>
            <size>0.030 0.040</size>
            <origin>0.5 0.5</origin>
            <text>B</text>
            <fontSize>0.020</fontSize>
            <color>0A2FA0</color>
            <backgroundColor>FFFFFFFF</backgroundColor>
            <backgroundCornerRadius>0.5</backgroundCornerRadius>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>
        <text name="footWordB">
            <pos>0.154 0.955</pos>
            <origin>0 0.5</origin>
            <text>BACK</text>
            <fontSize>0.016</fontSize>
            <color>FFFFFFFF</color>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>
        <text name="footBadgeY">
            <pos>0.211 0.955</pos>
            <size>0.030 0.040</size>
            <origin>0.5 0.5</origin>
            <text>Y</text>
            <fontSize>0.020</fontSize>
            <color>0A2FA0</color>
            <backgroundColor>FFFFFFFF</backgroundColor>
            <backgroundCornerRadius>0.5</backgroundCornerRadius>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>
        <text name="footWordY">
            <pos>0.236 0.955</pos>
            <origin>0 0.5</origin>
            <text>OPTIONS</text>
            <fontSize>0.016</fontSize>
            <color>FFFFFFFF</color>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>
    </view>
</theme>
