<?xml version="1.0" encoding="UTF-8"?>
<theme>
    <!-- Crystal v4.0: 4:3 Nova layout. Text inherits the base panel
         positions from views.xml; only content and the measured name size
         are set here (DejaVu Sans Bold, title box 0.24). -->
    <include>./../variables.xml</include>
    <include>./../views.xml</include>
    <view name="system">
        <text name="mfrBadge">
            <text>NINTENDO</text>
        </text>
        <!-- sysName: two-line sysName1/2 below -->
        <text name="sysName1">
            <!-- two-line name mirrors the baked graffiti title -->
            <pos>0.030 0.226</pos>
            <size>0.24 0.05</size>
            <fontSize>0.031</fontSize> <!-- v6.0.3: 0.032 overflowed the 0.24 box (310px) -->
            <color>${crystalText}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>50</zIndex>
            <text>SUPER NINTENDO</text>
        </text>
        <text name="sysName2">
            <pos>0.030 0.266</pos>
            <size>0.24 0.036</size>
            <fontSize>0.022</fontSize>
            <color>${crystalText}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>50</zIndex>
            <text>ENTERTAINMENT SYSTEM</text>
        </text>
        <text name="sysDesc">
            <pos>0.030 0.408</pos>
            <!-- v6.0.4: per-console polish — divider lines measured 0.386/0.511 from this background; desc 0.408 / count 0.539 / facts 0.622 -->
            <text>The 16-bit golden age. Mode 7 magic.</text>
        </text>
        <text name="countNum">
            <pos>0.030 0.539</pos>
        </text>
        <text name="factsLine">
            <pos>0.030 0.622</pos>
            <text>16-BIT • 1991</text>
        </text>
    </view>
    <view name="gamelist">
        <!-- v5.3.0: supplied per-console logo replaces the temporary
             text label. The base text element is hidden; the logo is
             a separate image element so no element-type merge
             semantics are relied upon. -->
        <text name="libConsoleName">
            <visible>false</visible>
        </text>
        <image name="libConsoleLogo">
            <pos>0.5 0.822917</pos>
            <maxSize>0.21 0.105</maxSize>
            <origin>0.5 0.5</origin>
            <path>./../art/console_logos/snes.png</path>
            <zIndex>60</zIndex>
        </image>
    </view>
</theme>