<?xml version="1.0" encoding="UTF-8"?>
<theme>
    <!-- Crystal v3 single palette: blue comic + white, small yellow accents.
         IMPORTANT: ES-DE reads the variable name from the TAG NAME and the
         value from the TEXT CONTENT (<name>value</name>). The
         <variable name="" value=""/> form defines NOTHING. -->
    <variables>
        <crystalText>FFFFFF</crystalText>
        <crystalDim>BFD4FF</crystalDim>
        <crystalAccent>FFD60A</crystalAccent>
        <crystalDeep>0A2FA0</crystalDeep>
        <crystalSelect>FFD60A2E</crystalSelect>
        <crystalGameBg>0A2FA0CC</crystalGameBg>
    </variables>
</theme>
