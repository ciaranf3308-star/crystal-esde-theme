<?xml version="1.0" encoding="UTF-8"?>
<theme>
    <!-- Crystal v4.0: 4:3 Nova layout. Text inherits the base panel
         positions from views.xml; only content and the measured name size
         are set here (DejaVu Sans Bold, title box 0.24). -->
    <include>./../variables.xml</include>
    <include>./../views.xml</include>
    <view name="system">
        <text name="mfrBadge">
            <text>SEGA</text>
        </text>
        <text name="sysName">
            <!-- measured with DejaVu Sans Bold: fullName fits one line on the 4:3 panel -->
            <fontSize>0.040</fontSize>
            <text>Mega Drive</text>

        </text>
        <text name="sysDesc">
            <text>Europe's name for Sega's 16-bit speed machine.</text>
        </text>
        <text name="countNum">
        </text>
        <text name="factsLine">
            <text>16-BIT • 1990</text>
        </text>
        <!-- v4.4.0 "Select": the selected carousel card shows this
             system's vivid supplied poster, pixel-aligned over the 2x
             selected slot (center 0.5 0.812, size 0.19 0.338 = 243x324
             at 1280x960). ES-DE renders one texture per carousel entry,
             so the selected-state art lives here as a per-system image
             element (z55, above the z45 carousel) that follows the
             selected system. Unselected entries keep the generic black
             marquee cards from the carousel's staticImage. -->
        <image name="selectedPoster">
            <pos>0.5 0.812</pos>
            <size>0.19 0.338</size>
            <origin>0.5 0.5</origin>
            <path>./../art/poster_on/megadrive.png</path>
            <cornerRadius>0.008</cornerRadius>
            <zIndex>55</zIndex>
        </image>
    </view>
    <view name="gamelist">
        <!-- v5.3.0: supplied per-console logo replaces the temporary
             text label. The base text element is hidden; the logo is
             a separate image element so no element-type merge
             semantics are relied upon. -->
        <text name="libConsoleName">
            <visible>false</visible>
        </text>
        <image name="libConsoleLogo">
            <pos>0.5 0.75</pos>
            <maxSize>0.56 0.10</maxSize>
            <origin>0.5 0.5</origin>
            <path>./../art/console_logos/megadrive.png</path>
            <zIndex>60</zIndex>
        </image>
    </view>
</theme>