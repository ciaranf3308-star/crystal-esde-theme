<?xml version="1.0" encoding="UTF-8"?>
<theme>
    <!-- Crystal v3 per-system text overrides for the info panel. -->
    <include>./../variables.xml</include>
    <include>./../views.xml</include>
    <view name="system">
        <text name="mfrBadge">
            <text>NINTENDO</text>
        </text>
        <text name="sysName">
            <!-- long fullName: smaller so it fits one line before the graffiti title -->
            <fontSize>0.018</fontSize>
        </text>
        <text name="sysDesc">
            <text>Nintendo's 32-bit handheld brought iconic franchises and a massive 2D library to a new generation.</text>
        </text>
        <text name="factsLine">
            <text>32-BIT • HANDHELD • 2001</text>
        </text>
    </view>
</theme>
