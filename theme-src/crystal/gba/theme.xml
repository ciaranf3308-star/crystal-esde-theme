<?xml version="1.0" encoding="UTF-8"?>
<theme>
    <!-- Crystal v4.0: 4:3 Nova layout. Text inherits the base panel
         positions from views.xml; only content and the measured name size
         are set here (DejaVu Sans Bold, title box 0.24). -->
    <include>./../variables.xml</include>
    <!-- v18.3.0: Light/Dark color schemes (palette variables for the
         selected scheme; re-applied here so per-system views resolve
         the scheme palette however the root/system parses order). -->
    <include>./../colorschemes.xml</include>
    <include>./../views.xml</include>
    <view name="system">
        <text name="mfrBadge">
            <text>NINTENDO</text>
        </text>
        <text name="sysName">
            <!-- short name (base systemdata binding removed: it overrode this) -->
            <fontSize>0.0288</fontSize>
            <text>Game Boy Advance</text>
        </text>
                    <!-- v6.0.4: per-console polish — divider lines measured 0.339/0.493 from this background; desc 0.361 / count 0.521 / facts 0.604 -->
        <text name="sysDesc">
            <pos>0.030 0.361</pos>
            <text>Nintendo's 32-bit handheld. A massive 2D library.</text>
        </text>
        <text name="countNum">
            <pos>0.030 0.521</pos>
        </text>
        <text name="factsLine">
            <pos>0.030 0.604</pos>
            <text>32-BIT • HANDHELD • 2001</text>
        </text>
    </view>
</theme>