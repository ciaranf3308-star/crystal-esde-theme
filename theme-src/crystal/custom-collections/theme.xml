<?xml version="1.0" encoding="UTF-8"?>
<theme>
    <!-- Crystal v18.5.2: custom collections support. ES-DE's
         CollectionSystemsManager maps every custom collection system
         (created on the Nova via Main Menu > Game Collection Settings)
         to this folder's theme.xml, so one module styles every
         collection the user creates: carousel > collection > the
         standard Crystal gamelist (inherited from views.xml, fully
         generic - no override needed here).
         Text inherits the base panel positions from views.xml; only
         content is set here. sysName binds ${system.name} so each
         collection shows its own name (the 21 console modules hardcode
         theirs; collections are user-named). -->
    <include>./../variables.xml</include>
    <!-- v18.3.0: Light/Dark color schemes (palette variables for the
         selected scheme; re-applied here so per-system views resolve
         the scheme palette however the root/system parses order). -->
    <include>./../colorschemes.xml</include>
    <include>./../views.xml</include>
    <view name="system">
        <!-- Supplied "Collections - All Your Worlds" scene (1448x1086,
             native 4:3, same geometry as the 14 standard backgrounds).
             v18.5.2: the baked "Collections / ALL YOUR WORLDS" title was
             removed from the scene (sky-white halftone wash painted over
             the title zone, feathered into the artwork) because the lockup
             PNG is now the hero logo (sysHeroLogo below) - keeping the
             baked title would double-render. The small "SORTED BY
             SERIES" tagline was covered by the same edit: it sat inside
             the hero's footprint and would have collided with the logo.
             All other art (NOVA logo, taglines, game folders, baked info
             panel) untouched. Fixed path: ${system.name} would resolve
             to the collection's name, which has no baked art. Scheme
             tint inherited. -->
        <image name="sysBackground">
            <pos>0 0</pos>
            <size>1 1</size>
            <origin>0 0</origin>
            <path>./../backgrounds/custom-collections.webp</path>
            <default>./../backgrounds/_default.webp</default>
            <color>${sysBgTint}</color>
            <zIndex>1</zIndex>
        </image>
        <!-- v18.5.2: sysHeroLogo - the supplied "Collections / ALL YOUR
             WORLDS" lockup as the big main hero, PS1-spec geometry
             mirrored exactly from views.xml (pos 0.64 0.39, maxSize
             0.58 0.29, origin 0.5 0.5, rotation -28, z30). The
             background's baked title was removed for this (see below);
             the lockup PNG is now the undisputed hero. Fixed path:
             ${system.name} would resolve to the collection's name,
             which has no baked art. -->
        <image name="sysHeroLogo">
            <pos>0.64 0.39</pos>
            <maxSize>0.58 0.29</maxSize>
            <origin>0.5 0.5</origin>
            <rotation>-28</rotation>
            <rotationOrigin>0.5 0.5</rotationOrigin>
            <path>./../art/console_logos/custom-collections.png</path>
            <zIndex>30</zIndex>
        </image>
        <!-- v18.5.1: carousel card. The shared carousel binds
             cards/${system.name}.png, which cannot resolve for a
             user-named collection (falls back to cards/_default.png, so
             v18.5.0 showed the generic card in the strip). Fixed path
             so every custom collection shows the supplied framed card
             in the strip - with the "Collections / ALL YOUR WORLDS"
             lockup baked into its top, the card IS the carousel logo.
             Only this property is overridden; all carousel geometry,
             dimming and transitions stay inherited from views.xml. -->
        <carousel name="sysCarousel">
            <staticImage>./../cards/custom-collections.png</staticImage>
        </carousel>
        <text name="mfrBadge">
            <text>NOVA</text>
        </text>
        <text name="sysName">
            <fontSize>0.0400</fontSize>
            <text>${system.name}</text>
        </text>
        <text name="sysDesc">
            <text>Your hand-picked shelf.</text>
        </text>
        <text name="factsLine">
            <text>CUSTOM • CURATED</text>
        </text>
    </view>
</theme>
