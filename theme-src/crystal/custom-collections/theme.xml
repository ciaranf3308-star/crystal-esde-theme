<?xml version="1.0" encoding="UTF-8"?>
<theme>
    <!-- Crystal v18.5.0: custom collections support. ES-DE's
         CollectionSystemsManager maps every custom collection system
         (created on the Nova via Main Menu > Game Collection Settings)
         to this folder's theme.xml, so one module styles every
         collection the user creates: carousel > collection > the
         standard Crystal gamelist (inherited from views.xml, fully
         generic - no override needed here).
         Text inherits the base panel positions from views.xml; only
         content is set here. sysName binds ${system.name} so each
         collection shows its own name (the 21 console modules hardcode
         theirs; collections are user-named). -->
    <include>./../variables.xml</include>
    <!-- v18.3.0: Light/Dark color schemes (palette variables for the
         selected scheme; re-applied here so per-system views resolve
         the scheme palette however the root/system parses order). -->
    <include>./../colorschemes.xml</include>
    <include>./../views.xml</include>
    <view name="system">
        <!-- Supplied "Collections - All Your Worlds" scene (1448x1086,
             native 4:3, same geometry as the 14 standard backgrounds).
             Fixed path: ${system.name} would resolve to the collection's
             name, which has no baked art. Scheme tint inherited. -->
        <image name="sysBackground">
            <pos>0 0</pos>
            <size>1 1</size>
            <origin>0 0</origin>
            <path>./../backgrounds/custom-collections.webp</path>
            <default>./../backgrounds/_default.webp</default>
            <color>${sysBgTint}</color>
            <zIndex>1</zIndex>
        </image>
        <!-- No sysHeroLogo override: unlike the 21 console collages,
             the supplied background is a complete composition with the
             "Collections / ALL YOUR WORLDS" lockup already baked in as
             the centerpiece - layering the logo asset on top would
             double-render the title. The baked lockup IS the hero. -->
        <text name="mfrBadge">
            <text>NOVA</text>
        </text>
        <text name="sysName">
            <fontSize>0.0400</fontSize>
            <text>${system.name}</text>
        </text>
        <text name="sysDesc">
            <text>Your hand-picked shelf.</text>
        </text>
        <text name="factsLine">
            <text>CUSTOM • CURATED</text>
        </text>
    </view>
</theme>
