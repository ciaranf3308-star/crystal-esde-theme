<?xml version="1.0" encoding="UTF-8"?>
<theme>
    <!-- Crystal v3.3 system view: 4:3 hero composition for the Nova (1280x960).
         - Baked 4:3 comic background with the blue info panel at
           x 0.013..0.28, y 0.17..0.97 (fractions of the 4:3 frame).
         - The 5 supplied heroes are rendered on their own, fullscreen.
         - Live text inside the panel: manufacturer badge, system name,
           description, game count, facts line.
         - v4.0.0: horizontal carousel of per-system hardware cards across
           the lower strip (y 0.70..1.00), much bigger cards, no clipping. -->
    <view name="system">
        <image name="sysBackground">
            <pos>0 0</pos>
            <size>1 1</size>
            <origin>0 0</origin>
            <path>./backgrounds/${system.name}.webp</path>
            <default>./backgrounds/_default.webp</default>
            <zIndex>1</zIndex>
        </image>

        <!-- v6.0.3: console-by-console polish sweep. The v6.0.2 uniform
             positions put desc text ON the baked white divider lines on
             15 of 21 backgrounds (each background rules its dividers
             differently). Positions are now threaded per background,
             measured from the baked art (work/analyze_ruled.py), in four
             groups — proof work/proof_syspanel.py asserts zero text/text
             overlap and zero divider collisions for all 21 consoles:
             A (13 consoles, dividers ~0.339/~0.493): desc 0.356,
                count 0.520, facts 0.603
             B (gbc, dividers 0.2965/0.4259): desc 0.312, count 0.444,
                facts 0.527
             C (snes, dividers 0.3353/0.3855/0.5115): desc 0.404,
                count 0.530, facts 0.613
             D (gb, nes, psx, steam, windows, xbox360 — no mid dividers):
                base positions below (nes/snes keep the two-line lower
                variant). Also v6.0.3: removed gb's leftover sysDesc size
                override; snes sysName1 0.032 -> 0.031 (overflowed the
                0.24 box by 3px). -->
        <text name="mfrBadge">
            <pos>0.030 0.195</pos>
            <size>0.16 0</size>
            <origin>0 0</origin>
            <fontSize>0.018</fontSize>
            <color>0A2FA0</color>
            <backgroundColor>FFFFFFFF</backgroundColor>
            <backgroundCornerRadius>0.007</backgroundCornerRadius>
            <backgroundMargins>0.010 0.005</backgroundMargins>
            <letterCase>uppercase</letterCase>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>50</zIndex>
        </text>
        <text name="sysName">
            <pos>0.030 0.230</pos>
            <size>0.24 0.055</size>
            <origin>0 0</origin>
            <fontSize>0.040</fontSize>
            <color>${crystalText}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>50</zIndex>
        </text>
        <text name="sysDesc">
            <pos>0.030 0.280</pos>
            <size>0.20 0.140</size>
            <origin>0 0</origin>
            <fontSize>0.019</fontSize>
            <color>${crystalText}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>50</zIndex>
        </text>
        <text name="countNum">
            <pos>0.030 0.373</pos>
            <size>0.20 0.07</size>
            <origin>0 0</origin>
            <systemdata>gamecountGames</systemdata>
            <fontSize>0.055</fontSize>
            <color>${crystalText}</color>
            <letterCase>uppercase</letterCase>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>50</zIndex>
        </text>
        <text name="factsLine">
            <pos>0.030 0.451</pos>
            <size>0.20 0.04</size>
            <origin>0 0</origin>
            <fontSize>0.017</fontSize>
            <color>${crystalAccent}</color>
            <letterCase>uppercase</letterCase>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>50</zIndex>
        </text>

        <!-- Crystal v4.1.0: the glossy deep-blue carousel stage ("blue bar"
             under the carousel) was removed at the user's request. The
             carousel now floats directly over the system background. -->

        <!-- Crystal v4.0.0 carousel rebuild. v3.x lessons, learned the hard
             way on the Nova:
             - The device renders the design faithfully: v3 cards were
               118x154px because itemSize was 0.092x0.160. v4 cards are
               166x206 (+41% unfocused, +32% selected).
             - ES-DE 3.4.1 scissor-clips carousel children to the carousel
               rect (CarouselComponent::render pushClipRect). The v3
               selected card (1.33x + 19px lift) overflowed the top by ~36px
               and was visibly sliced on device. v4 geometry is verified
               against the engine's own layout math: yOff=41px >= 36px of
               selected overflow. Proof mocks now simulate the scissor rect.
             - 3.4.1's ImageComponent has no GIF/animation support and the
               carousel hard-creates ImageComponents (no itemTemplate), so
               the strip cannot animate on this ES-DE version. v4.1.0 uses
               static cards: the 7 systems with user-supplied posters show
               the vivid "on" poster (selected = vivid, neighbours dimmed
               by unfocusedItemSaturation/unfocusedItemDimming: the same
               on/off language, done per-frame); the other 14 keep the
               v3.6.0 trading cards. The animated GIFs stay parked in
               cards_anim/ for a future <animation>-element showcase.
             v4.3.0 "Spotlight": the cards are now black marquee boxes with
             the console name in hero-style white text (the user's art lives
             on as a faint dark texture inside the box). The selected item
             is 2x the unfocused size (itemScale 2.0), lifted, sitting in a
             soft radial glow (art/carousel_glow.png, z40) over a whisper
             bottom vignette (art/sys_vignette.png, z39) — shading, not a
             bar. Geometry at 1280x960: item 122x162, selected 243x324,
             7 items, reflections off. -->
        <!-- v4.3.0: bottom vignette — a soft dark bed under the carousel
             zone. Neutral black, max ~30% at the screen edge, feathered
             out well above the cards. It must never read as a bar. -->
        <image name="sysVignette">
            <pos>0 0.600</pos>
            <size>1 0.400</size>
            <origin>0 0</origin>
            <path>./art/sys_vignette.png</path>
            <zIndex>39</zIndex>
        </image>
        <!-- v4.3.0: spotlight glow behind the carousel's center. The
             selected item is always centered, so this reads as a glow
             around the selected card. -->
        <image name="carouselGlow">
            <pos>0.5 0.812</pos>
            <size>0.484 0.479</size>
            <origin>0.5 0.5</origin>
            <path>./art/carousel_glow.png</path>
            <zIndex>40</zIndex>
        </image>
        <!-- v4.4.0 "Select": the 7 systems with user-supplied posters
             (genesis, ps2, dreamcast, psx, megadrive, n64, gc) show the
             vivid supplied poster on the SELECTED card via a per-system
             <image name="selectedPoster"> overlay (z55, pixel-aligned to
             the 2x selected slot at 0.5 0.812). ES-DE 3.4.1 renders one
             texture per carousel entry, so selected-state art cannot live
             in the carousel itself. Unselected entries keep the generic
             black marquee cards below. -->
        <carousel name="sysCarousel">
            <type>horizontal</type>
            <pos>0 0.640</pos>
            <size>1 0.360</size>
            <origin>0 0</origin>
            <!-- The carousel paints its own background rect with this color.
                 Transparent so the system background shows through
                 (v4.1.0: the old vignette stage under the carousel is gone). -->
            <color>00000000</color>
            <staticImage>./cards/${system.name}.png</staticImage>
            <defaultImage>./cards/_default.png</defaultImage>
            <!-- v4.3.0: 2x selected. Unfocused 122x162 (0.095x0.169),
                 selected 243x324 — fits the 346px zone centered with
                 ~11px headroom, so the scissor rect never clips it. -->
            <itemSize>0.095 0.169</itemSize>
            <itemScale>2.0</itemScale>
            <maxItemCount>7</maxItemCount>
            <itemStacking>ascendingRaised</itemStacking>
            <selectedItemOffset>0 -0.008</selectedItemOffset>
            <selectedItemMargins>0.010 0.010</selectedItemMargins>
            <reflections>false</reflections>
            <imageCornerRadius>0.008</imageCornerRadius>
            <!-- v4.3.0: gentle recession — the black boxes stay black and
                 their names stay readable; the 2x scale + glow + full
                 brightness carry the selection, not heavy dimming. -->
            <unfocusedItemOpacity>0.92</unfocusedItemOpacity>
            <unfocusedItemSaturation>0.85</unfocusedItemSaturation>
            <unfocusedItemDimming>0.22</unfocusedItemDimming>
            <imageInterpolation>linear</imageInterpolation>
            <itemTransitions>animate</itemTransitions>
            <fastScrolling>true</fastScrolling>
            <zIndex>45</zIndex>
        </carousel>

        <helpsystem name="sysHelp">
            <pos>0.5 0.982</pos>
            <origin>0.5 0.5</origin>
            <textColor>${crystalDim}</textColor>
            <iconColor>${crystalAccent}</iconColor>
            <fontSize>0.0145</fontSize>
        </helpsystem>
    </view>

    <view name="gamelist">
        <!-- v7.0.0 flagship pass: the gamelist as a composed interface,
             not media on a background. Verified against ES-DE v3.4.1
             source (CarouselComponent.h, HelpComponent.cpp,
             ThemeData.cpp element tables).

             Composition (1280x960), visual order:
               1. selected physical media — 1.6x, lifted, glow + shadow
               2. marquee hero layer — large, tilted, screen-printed
               3. editorial title block — rule, title, kicker line
               4. neighbour media — 62%, dimmed, edge peeks continue
               5. editorial metadata block — YEAR leads, weight descends
               6. system logo anchor
               7. quiet single footer row

             Motion: the engine animates carousel selection changes
             (itemTransitions=animate); there is no keyframe/idle
             animation in the theme engine, so the "float" is scale +
             lift + shadow + glow, and the settle is the native easing. -->

        <!-- 1. Supplied universal Nova library background, full-bleed.
             Never covered with opaque panels: the pale negative centre
             carries the marquee and the media, the deep-blue lower
             third carries the title block. -->
        <image name="libBackground">
            <pos>0 0</pos>
            <size>1 1</size>
            <origin>0 0</origin>
            <path>./art/gamelist_generic_bg.png</path>
            <zIndex>1</zIndex>
        </image>

        <!-- 2. MARQUEE HERO LAYER. The scraped marquee as a major
             atmospheric graphic: dramatically scaled, tilted -8deg,
             ~32% opacity, desaturated toward royal blue/white so it
             reads screen-printed into the Nova artwork. Bleeds off the
             left edge; sits behind carousel and metadata. -->
        <text name="libMarqueeTitle">
            <pos>0.03 0.10</pos>
            <size>0.50 0.26</size>
            <origin>0 0</origin>
            <metadata>name</metadata>
            <letterCase>uppercase</letterCase>
            <fontSize>0.054</fontSize>
            <color>${crystalDeep}</color>
            <opacity>0.45</opacity>
            <horizontalAlignment>left</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>19</zIndex>
        </text>
        <image name="libMarquee">
            <pos>0.24 0.235</pos>
            <maxSize>0.50 0.34</maxSize>
            <origin>0.5 0.5</origin>
            <rotation>-6</rotation>
            <rotationOrigin>0.5 0.5</rotationOrigin>
            <imageType>marquee</imageType>
            <opacity>0.32</opacity>
            <saturation>0.12</saturation>
            <color>9DB4FF</color>
            <zIndex>20</zIndex>
        </image>

        <!-- 3. EDITORIAL METADATA BLOCK, upper-right. Magazine
             information hierarchy with descending visual weight:
             YEAR leads large, then GENRE, PLAYERS, DEVELOPER, the
             rating, and the description as quiet supporting text.
             No labels, no panel. -->
        <datetime name="libYear">
            <pos>0.665 0.060</pos>
            <size>0.29 0.055</size>
            <origin>0 0</origin>
            <metadata>releasedate</metadata>
            <format>%Y</format>
            <fontSize>0.038</fontSize>
            <color>${crystalDeep}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <verticalAlignment>top</verticalAlignment>
            <zIndex>60</zIndex>
        </datetime>
        <text name="libGenre">
            <pos>0.665 0.122</pos>
            <size>0.29 0.038</size>
            <origin>0 0</origin>
            <metadata>genre</metadata>
            <letterCase>uppercase</letterCase>
            <fontSize>0.024</fontSize>
            <color>${crystalDeep}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <verticalAlignment>top</verticalAlignment>
            <zIndex>60</zIndex>
        </text>
        <text name="libPlayers">
            <pos>0.665 0.166</pos>
            <size>0.29 0.032</size>
            <origin>0 0</origin>
            <metadata>players</metadata>
            <letterCase>uppercase</letterCase>
            <fontSize>0.020</fontSize>
            <color>${crystalInkDim}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <verticalAlignment>top</verticalAlignment>
            <zIndex>60</zIndex>
        </text>
        <text name="libDev">
            <pos>0.665 0.198</pos>
            <size>0.29 0.032</size>
            <origin>0 0</origin>
            <metadata>developer</metadata>
            <letterCase>uppercase</letterCase>
            <fontSize>0.020</fontSize>
            <color>${crystalInkDim}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <verticalAlignment>top</verticalAlignment>
            <zIndex>60</zIndex>
        </text>
        <rating name="libRating">
            <pos>0.665 0.242</pos>
            <size>0.15 0.032</size>
            <origin>0 0.5</origin>
            <filledPath>./art/star_filled.png</filledPath>
            <unfilledPath>./art/star_unfilled.png</unfilledPath>
            <hideIfZero>true</hideIfZero>
            <zIndex>60</zIndex>
        </rating>
        <text name="libDesc">
            <pos>0.665 0.276</pos>
            <size>0.29 0.165</size>
            <origin>0 0</origin>
            <metadata>description</metadata>
            <fontSize>0.0175</fontSize>
            <color>${crystalInkDim}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <verticalAlignment>top</verticalAlignment>
            <zIndex>60</zIndex>
        </text>

        <!-- 4. SELECTED-MEDIA ATMOSPHERE. Wide faint blue secondary
             glow, tighter soft yellow core glow, and a soft contact
             shadow grounding the lift. Static — the selected slot is
             always centred, so these never move. -->
        <image name="libSelectedGlowBlue">
            <pos>0.5 0.50</pos>
            <size>0.36 0.46</size>
            <origin>0.5 0.5</origin>
            <path>./art/lib_glow_blue.png</path>
            <opacity>0.55</opacity>
            <zIndex>47</zIndex>
        </image>
        <image name="libSelectedGlow">
            <pos>0.5 0.525</pos>
            <size>0.34 0.43</size>
            <origin>0.5 0.5</origin>
            <path>./art/lib_glow_yellow.png</path>
            <opacity>0.50</opacity>
            <zIndex>48</zIndex>
        </image>
        <image name="libSelectedShadow">
            <pos>0.5 0.698</pos>
            <size>0.30 0.055</size>
            <origin>0.5 0.5</origin>
            <path>./art/lib_shadow_soft.png</path>
            <opacity>0.60</opacity>
            <zIndex>49</zIndex>
        </image>

        <!-- 5. THE MEDIA ROW. type=horizontal with maxItemCount 4:
             selected centred, immediate neighbours at 0.25/0.75, the
             +/-2 items half off-screen so the collection reads as
             continuing past the display. itemVerticalAlignment=bottom
             glues every item's bottom to the box; itemScale 1.6 grows
             the selected UP from there (neighbours read at 62%).
             selectedItemOffset lifts only the selected item above the
             neighbour baseline. Unfocused items drop in opacity,
             saturation and brightness for real depth steps. -->
        <carousel name="gameCarousel">
            <type>horizontal</type>
            <color>00000000</color>
            <pos>0.5 0.485</pos>
            <size>1 0.44</size>
            <origin>0.5 0.5</origin>
            <imageType>physicalmedia 3dbox</imageType>
            <defaultImage>./media_fallbacks/${system.name}.png</defaultImage>
            <itemSize>0.16 0.2133</itemSize>
            <itemScale>1.6</itemScale>
            <maxItemCount>4.0</maxItemCount>
            <itemVerticalAlignment>bottom</itemVerticalAlignment>
            <selectedItemOffset>0 -0.02</selectedItemOffset>
            <reflections>false</reflections>
            <unfocusedItemOpacity>0.68</unfocusedItemOpacity>
            <unfocusedItemSaturation>0.7</unfocusedItemSaturation>
            <unfocusedItemDimming>0.30</unfocusedItemDimming>
            <imageInterpolation>linear</imageInterpolation>
            <itemTransitions>animate</itemTransitions>
            <fastScrolling>true</fastScrolling>
            <zIndex>50</zIndex>
        </carousel>

        <!-- 6. TITLE BLOCK. Yellow editorial rule, the game name set
             large in uppercase, and a single kicker line beneath:
             GENRE • YEAR • PLAYERS with yellow separators. -->
        <image name="libTitleRule">
            <pos>0.5 0.726</pos>
            <size>0.075 0.008</size>
            <origin>0.5 0.5</origin>
            <path>./art/lib_rule_yellow.png</path>
            <zIndex>60</zIndex>
        </image>
        <text name="libGameName">
            <pos>0.5 0.764</pos>
            <size>0.78 0.075</size>
            <origin>0.5 0.5</origin>
            <metadata>name</metadata>
            <letterCase>uppercase</letterCase>
            <fontSize>0.042</fontSize>
            <color>FFFFFF</color>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>
        <text name="libSubGenre">
            <pos>0.37 0.814</pos>
            <size>0.14 0.03</size>
            <origin>0.5 0.5</origin>
            <metadata>genre</metadata>
            <letterCase>uppercase</letterCase>
            <fontSize>0.018</fontSize>
            <color>${crystalDim}</color>
            <horizontalAlignment>right</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>
        <text name="libSep1">
            <pos>0.462 0.814</pos>
            <size>0.03 0.03</size>
            <origin>0.5 0.5</origin>
            <text>•</text>
            <fontSize>0.018</fontSize>
            <color>${crystalAccent}</color>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>
        <datetime name="libSubYear">
            <pos>0.5 0.814</pos>
            <size>0.06 0.03</size>
            <origin>0.5 0.5</origin>
            <metadata>releasedate</metadata>
            <format>%Y</format>
            <fontSize>0.018</fontSize>
            <color>${crystalDim}</color>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </datetime>
        <text name="libSep2">
            <pos>0.538 0.814</pos>
            <size>0.03 0.03</size>
            <origin>0.5 0.5</origin>
            <text>•</text>
            <fontSize>0.018</fontSize>
            <color>${crystalAccent}</color>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>
        <text name="libSubPlayers">
            <pos>0.63 0.814</pos>
            <size>0.14 0.03</size>
            <origin>0.5 0.5</origin>
            <metadata>players</metadata>
            <letterCase>uppercase</letterCase>
            <fontSize>0.018</fontSize>
            <color>${crystalDim}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>

        <!-- 7. SYSTEM LOGO anchor, lower-centre with breathing room.
             Per-system overrides supply the artwork (16 systems) or
             the text name (nes, psp, xbox360, steam, windows). -->
        <text name="libConsoleName">
            <pos>0.5 0.880</pos>
            <size>0.70 0.055</size>
            <origin>0.5 0.5</origin>
            <fontSize>0.032</fontSize>
            <color>FFFFFF</color>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>

        <!-- 8. THE footer row: one compact helpsystem, quiet. Present
             for discoverability, absent from the composition. -->
        <helpsystem name="libHelp">
            <pos>0.5 0.952</pos>
            <origin>0.5 0.5</origin>
            <fontSize>0.016</fontSize>
            <textColor>A6FFFFFF</textColor>
            <iconColor>A6FFFFFF</iconColor>
            <entrySpacing>0.025</entrySpacing>
        </helpsystem>

    </view>

</theme>
