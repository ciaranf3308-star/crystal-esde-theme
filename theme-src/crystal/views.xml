<?xml version="1.0" encoding="UTF-8"?>
<theme>
    <!-- Crystal v3.3 system view: 4:3 hero composition for the Nova (1280x960).
         - Baked 4:3 comic background with the blue info panel at
           x 0.013..0.28, y 0.17..0.97 (fractions of the 4:3 frame).
         - The 5 supplied heroes are rendered on their own, fullscreen.
         - Live text inside the panel: manufacturer badge, system name,
           description, game count, facts line.
         - v4.0.0: horizontal carousel of per-system hardware cards across
           the lower strip (y 0.70..1.00), much bigger cards, no clipping. -->
    <view name="system">
        <image name="sysBackground">
            <pos>0 0</pos>
            <size>1 1</size>
            <origin>0 0</origin>
            <path>./backgrounds/${system.name}.webp</path>
            <default>./backgrounds/_default.webp</default>
            <zIndex>1</zIndex>
        </image>

        <!-- v4.0.0: panel text rebuilt — bigger, real hierarchy. The v3 text
             was small and clustered in the top half of the tall panel
             (15px badge / 29px title / 15px dim description) and looked
             lost on the Nova. Now: 17px badge, 38px title, 18px
             description in white (was dim), 53px count, 16px yellow facts.
             Per-system theme.xml files carry the measured name sizes
             (DejaVu Sans Bold, 4:3 panel, box 0.24). -->
        <text name="mfrBadge">
            <pos>0.030 0.195</pos>
            <size>0.16 0</size>
            <origin>0 0</origin>
            <fontSize>0.018</fontSize>
            <color>0A2FA0</color>
            <backgroundColor>FFFFFFFF</backgroundColor>
            <backgroundCornerRadius>0.007</backgroundCornerRadius>
            <backgroundMargins>0.010 0.005</backgroundMargins>
            <letterCase>uppercase</letterCase>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>50</zIndex>
        </text>
        <text name="sysName">
            <pos>0.030 0.230</pos>
            <size>0.24 0.055</size>
            <origin>0 0</origin>
            <systemdata>fullname</systemdata>
            <fontSize>0.040</fontSize>
            <color>${crystalText}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>50</zIndex>
        </text>
        <text name="sysDesc">
            <pos>0.030 0.281</pos>
            <size>0.20 0.140</size>
            <origin>0 0</origin>
            <fontSize>0.019</fontSize>
            <color>${crystalText}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>50</zIndex>
        </text>
        <text name="countNum">
            <pos>0.030 0.354</pos>
            <size>0.20 0.07</size>
            <origin>0 0</origin>
            <systemdata>gamecountGames</systemdata>
            <fontSize>0.055</fontSize>
            <color>${crystalText}</color>
            <letterCase>uppercase</letterCase>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>50</zIndex>
        </text>
        <text name="factsLine">
            <pos>0.030 0.415</pos>
            <size>0.20 0.04</size>
            <origin>0 0</origin>
            <fontSize>0.017</fontSize>
            <color>${crystalAccent}</color>
            <letterCase>uppercase</letterCase>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>50</zIndex>
        </text>

        <!-- Crystal v4.1.0: the glossy deep-blue carousel stage ("blue bar"
             under the carousel) was removed at the user's request. The
             carousel now floats directly over the system background. -->

        <!-- Crystal v4.0.0 carousel rebuild. v3.x lessons, learned the hard
             way on the Nova:
             - The device renders the design faithfully: v3 cards were
               118x154px because itemSize was 0.092x0.160. v4 cards are
               166x206 (+41% unfocused, +32% selected).
             - ES-DE 3.4.1 scissor-clips carousel children to the carousel
               rect (CarouselComponent::render pushClipRect). The v3
               selected card (1.33x + 19px lift) overflowed the top by ~36px
               and was visibly sliced on device. v4 geometry is verified
               against the engine's own layout math: yOff=41px >= 36px of
               selected overflow. Proof mocks now simulate the scissor rect.
             - 3.4.1's ImageComponent has no GIF/animation support and the
               carousel hard-creates ImageComponents (no itemTemplate), so
               the strip cannot animate on this ES-DE version. v4.1.0 uses
               static cards: the 7 systems with user-supplied posters show
               the vivid "on" poster (selected = vivid, neighbours dimmed
               by unfocusedItemSaturation/unfocusedItemDimming: the same
               on/off language, done per-frame); the other 14 keep the
               v3.6.0 trading cards. The animated GIFs stay parked in
               cards_anim/ for a future <animation>-element showcase.
             v4.3.0 "Spotlight": the cards are now black marquee boxes with
             the console name in hero-style white text (the user's art lives
             on as a faint dark texture inside the box). The selected item
             is 2x the unfocused size (itemScale 2.0), lifted, sitting in a
             soft radial glow (art/carousel_glow.png, z40) over a whisper
             bottom vignette (art/sys_vignette.png, z39) — shading, not a
             bar. Geometry at 1280x960: item 122x162, selected 243x324,
             7 items, reflections off. -->
        <!-- v4.3.0: bottom vignette — a soft dark bed under the carousel
             zone. Neutral black, max ~30% at the screen edge, feathered
             out well above the cards. It must never read as a bar. -->
        <image name="sysVignette">
            <pos>0 0.600</pos>
            <size>1 0.400</size>
            <origin>0 0</origin>
            <path>./art/sys_vignette.png</path>
            <zIndex>39</zIndex>
        </image>
        <!-- v4.3.0: spotlight glow behind the carousel's center. The
             selected item is always centered, so this reads as a glow
             around the selected card. -->
        <image name="carouselGlow">
            <pos>0.5 0.812</pos>
            <size>0.484 0.479</size>
            <origin>0.5 0.5</origin>
            <path>./art/carousel_glow.png</path>
            <zIndex>40</zIndex>
        </image>
        <!-- v4.4.0 "Select": the 7 systems with user-supplied posters
             (genesis, ps2, dreamcast, psx, megadrive, n64, gc) show the
             vivid supplied poster on the SELECTED card via a per-system
             <image name="selectedPoster"> overlay (z55, pixel-aligned to
             the 2x selected slot at 0.5 0.812). ES-DE 3.4.1 renders one
             texture per carousel entry, so selected-state art cannot live
             in the carousel itself. Unselected entries keep the generic
             black marquee cards below. -->
        <carousel name="sysCarousel">
            <type>horizontal</type>
            <pos>0 0.640</pos>
            <size>1 0.360</size>
            <origin>0 0</origin>
            <!-- The carousel paints its own background rect with this color.
                 Transparent so the system background shows through
                 (v4.1.0: the old vignette stage under the carousel is gone). -->
            <color>00000000</color>
            <staticImage>./cards/${system.name}.png</staticImage>
            <defaultImage>./cards/_default.png</defaultImage>
            <!-- v4.3.0: 2x selected. Unfocused 122x162 (0.095x0.169),
                 selected 243x324 — fits the 346px zone centered with
                 ~11px headroom, so the scissor rect never clips it. -->
            <itemSize>0.095 0.169</itemSize>
            <itemScale>2.0</itemScale>
            <maxItemCount>7</maxItemCount>
            <itemStacking>ascendingRaised</itemStacking>
            <selectedItemOffset>0 -0.008</selectedItemOffset>
            <selectedItemMargins>0.010 0.010</selectedItemMargins>
            <reflections>false</reflections>
            <imageCornerRadius>0.008</imageCornerRadius>
            <!-- v4.3.0: gentle recession — the black boxes stay black and
                 their names stay readable; the 2x scale + glow + full
                 brightness carry the selection, not heavy dimming. -->
            <unfocusedItemOpacity>0.92</unfocusedItemOpacity>
            <unfocusedItemSaturation>0.85</unfocusedItemSaturation>
            <unfocusedItemDimming>0.22</unfocusedItemDimming>
            <imageInterpolation>linear</imageInterpolation>
            <itemTransitions>animate</itemTransitions>
            <fastScrolling>true</fastScrolling>
            <zIndex>45</zIndex>
        </carousel>

        <helpsystem name="sysHelp">
            <pos>0.5 0.982</pos>
            <origin>0.5 0.5</origin>
            <textColor>${crystalDim}</textColor>
            <iconColor>${crystalAccent}</iconColor>
            <fontSize>0.0145</fontSize>
        </helpsystem>
    </view>

    <!-- Crystal gamelist: library hero view (v4.9.0).
         The mockup: system hero background full-bleed (titles baked into
         the art), game carousel centered with the selected game large,
         marker-script title + metadata line below, A/B/Y footer.
         v4.9.0: the carousel is physical media ONLY (physicalmedia/3dbox
         — disk/cart/3D box, never box art). The selected game's scraped
         cover renders as a separate hero overlay (selectedArtwork, z52)
         pixel-aligned to the selected slot; with no scraped art it draws
         nothing and the selected disk shows through. 2-type carousel
         limit (CarouselComponent.h). Royal-blue wash (libBlueTint, z2)
         over the background on all 21 consoles; the game hero (carousel,
         artwork overlay, title) renders above it, untinted.
         Platform notes: carousel captions render ONLY for artless items,
         so neighbour names under art are impossible stock (the selected
         game's name lives in the hero title); no page-indicator element
         exists, so the mockup's dots are omitted. -->
    <view name="gamelist">
        <!-- System hero background, full-bleed. -->
        <image name="libBackground">
            <pos>0 0</pos>
            <size>1 1</size>
            <origin>0 0</origin>
            <path>./backgrounds/${system.name}.webp</path>
            <default>./backgrounds/_default.webp</default>
            <zIndex>1</zIndex>
        </image>

        <!-- v4.8.0: royal-blue wash over the per-system background, all
             21 consoles. Transparent blue only — the game hero (carousel,
             chevrons, title, metadata) renders above it, untinted. -->
        <image name="libBlueTint">
            <pos>0 0</pos>
            <size>1 1</size>
            <origin>0 0</origin>
            <path>./art/lib_blue_tint.png</path>
            <zIndex>2</zIndex>
        </image>

        <!-- Soft white glow behind the title block: the marker title is
             navy (mockup), so it needs a light bed on every system. -->
        <image name="libScrim">
            <pos>0.5 0.752</pos>
            <size>0.66 0.31</size>
            <origin>0.5 0.5</origin>
            <path>./art/lib_scrim.png</path>
            <zIndex>5</zIndex>
        </image>

        <!-- The primary: horizontal game carousel, selected game large.
             Left/right navigate, A launches. -->
        <carousel name="gameCarousel">
            <type>horizontal</type>
            <pos>0.5 0.465</pos>
            <size>1 0.42</size>
            <origin>0.5 0.5</origin>
            <color>00000000</color>
            <!-- v4.9.0: physical media ONLY in the carousel (disk/cart/3D
                 box) — never box art. The selected game's scraped cover
                 renders as a separate hero overlay above (selectedArtwork);
                 neighbours always stay physical media. -->
            <imageType>physicalmedia 3dbox</imageType>
            <defaultImage>./media_fallbacks/${system.name}.png</defaultImage>
            <itemSize>0.18 0.185</itemSize>
            <itemScale>1.9</itemScale>
            <maxItemCount>3</maxItemCount>
            <itemStacking>ascendingRaised</itemStacking>
            <selectedItemMargins>0.008 0.008</selectedItemMargins>
            <reflections>false</reflections>
            <imageCornerRadius>0.008</imageCornerRadius>
            <unfocusedItemOpacity>0.95</unfocusedItemOpacity>
            <unfocusedItemSaturation>0.8</unfocusedItemSaturation>
            <unfocusedItemDimming>0.25</unfocusedItemDimming>
            <imageInterpolation>linear</imageInterpolation>
            <itemTransitions>animate</itemTransitions>
            <fastScrolling>true</fastScrolling>
            <zIndex>50</zIndex>
        </carousel>

        <!-- v4.9.0: selected-game artwork hero. Per-game <image> with a
             non-empty imageType resolves the SELECTED game's media
             (GamelistView::setGameImage); on a miss it draws nothing, so
             the selected physical-media entry shows through untouched.
             Pixel-aligned to the 1.9x selected slot (0.342 x 0.3515 at
             0.5, 0.465, cornerRadius 0.008) so the cover swaps cleanly
             into the slot the disk occupied. -->
        <image name="selectedArtwork">
            <pos>0.5 0.465</pos>
            <size>0.342 0.3515</size>
            <origin>0.5 0.5</origin>
            <imageType>cover</imageType>
            <cornerRadius>0.008</cornerRadius>
            <zIndex>52</zIndex>
        </image>

        <!-- Chevron arrows at the carousel edges. -->
        <text name="chevLeft">
            <pos>0.030 0.465</pos>
            <origin>0.5 0.5</origin>
            <text>&lt;</text>
            <fontSize>0.045</fontSize>
            <color>FFFFFFFF</color>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>55</zIndex>
        </text>
        <text name="chevRight">
            <pos>0.970 0.465</pos>
            <origin>0.5 0.5</origin>
            <text>&gt;</text>
            <fontSize>0.045</fontSize>
            <color>FFFFFFFF</color>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>55</zIndex>
        </text>

        <!-- Marker-script title: the selected game's name. -->
        <text name="libTitle">
            <pos>0.5 0.735</pos>
            <size>0.72 0.095</size>
            <origin>0.5 0.5</origin>
            <metadata>name</metadata>
            <fontPath>./fonts/PermanentMarker-Regular.ttf</fontPath>
            <fontSize>0.068</fontSize>
            <color>${crystalDeep}</color>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>

        <!-- Metadata line: genre • year • developer • players. -->
        <text name="libGenre">
            <pos>0.28 0.808</pos>
            <size>0.10 0.024</size>
            <origin>0 0.5</origin>
            <metadata>genre</metadata>
            <fontSize>0.0165</fontSize>
            <color>${crystalInkDim}</color>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>
        <text name="libSep1">
            <pos>0.38 0.808</pos>
            <size>0.02 0.024</size>
            <origin>0 0.5</origin>
            <text>•</text>
            <fontSize>0.0165</fontSize>
            <color>${crystalInkDim}</color>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>
        <datetime name="libYear">
            <pos>0.40 0.808</pos>
            <size>0.065 0.024</size>
            <origin>0 0.5</origin>
            <metadata>releasedate</metadata>
            <format>%Y</format>
            <fontSize>0.0165</fontSize>
            <color>${crystalInkDim}</color>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </datetime>
        <text name="libSep2">
            <pos>0.465 0.808</pos>
            <size>0.02 0.024</size>
            <origin>0 0.5</origin>
            <text>•</text>
            <fontSize>0.0165</fontSize>
            <color>${crystalInkDim}</color>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>
        <text name="libDev">
            <pos>0.485 0.808</pos>
            <size>0.12 0.024</size>
            <origin>0 0.5</origin>
            <metadata>developer</metadata>
            <fontSize>0.0165</fontSize>
            <color>${crystalInkDim}</color>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>
        <text name="libSep3">
            <pos>0.605 0.808</pos>
            <size>0.02 0.024</size>
            <origin>0 0.5</origin>
            <text>•</text>
            <fontSize>0.0165</fontSize>
            <color>${crystalInkDim}</color>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>
        <text name="libPlayers">
            <pos>0.625 0.808</pos>
            <size>0.095 0.024</size>
            <origin>0 0.5</origin>
            <metadata>players</metadata>
            <fontSize>0.0165</fontSize>
            <color>${crystalInkDim}</color>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>

    </view>
</theme>
