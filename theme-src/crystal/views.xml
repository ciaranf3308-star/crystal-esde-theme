<?xml version="1.0" encoding="UTF-8"?>
<theme>
    <!-- Crystal v3.3 system view: 4:3 hero composition for the Nova (1280x960).
         - Baked 4:3 comic background with the blue info panel at
           x 0.013..0.28, y 0.17..0.97 (fractions of the 4:3 frame).
         - The 5 supplied heroes are rendered on their own, fullscreen.
         - Live text inside the panel: manufacturer badge, system name,
           description, game count, facts line.
         - v4.0.0: horizontal carousel of per-system hardware cards across
           the lower strip (y 0.70..1.00), much bigger cards, no clipping. -->
    <view name="system">
        <image name="sysBackground">
            <pos>0 0</pos>
            <size>1 1</size>
            <origin>0 0</origin>
            <path>./backgrounds/${system.name}.webp</path>
            <default>./backgrounds/_default.webp</default>
            <zIndex>1</zIndex>
        </image>

        <!-- v4.0.0: panel text rebuilt — bigger, real hierarchy. The v3 text
             was small and clustered in the top half of the tall panel
             (15px badge / 29px title / 15px dim description) and looked
             lost on the Nova. Now: 17px badge, 38px title, 18px
             description in white (was dim), 53px count, 16px yellow facts.
             Per-system theme.xml files carry the measured name sizes
             (DejaVu Sans Bold, 4:3 panel, box 0.24). -->
        <text name="mfrBadge">
            <pos>0.030 0.195</pos>
            <size>0.16 0</size>
            <origin>0 0</origin>
            <fontSize>0.018</fontSize>
            <color>0A2FA0</color>
            <backgroundColor>FFFFFFFF</backgroundColor>
            <backgroundCornerRadius>0.007</backgroundCornerRadius>
            <backgroundMargins>0.010 0.005</backgroundMargins>
            <letterCase>uppercase</letterCase>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>50</zIndex>
        </text>
        <text name="sysName">
            <pos>0.030 0.230</pos>
            <size>0.24 0.055</size>
            <origin>0 0</origin>
            <systemdata>fullname</systemdata>
            <fontSize>0.040</fontSize>
            <color>${crystalText}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>50</zIndex>
        </text>
        <text name="sysDesc">
            <pos>0.030 0.305</pos>
            <size>0.20 0.140</size>
            <origin>0 0</origin>
            <fontSize>0.019</fontSize>
            <color>${crystalText}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>50</zIndex>
        </text>
        <text name="countNum">
            <pos>0.030 0.460</pos>
            <size>0.20 0.07</size>
            <origin>0 0</origin>
            <systemdata>gamecountGames</systemdata>
            <fontSize>0.055</fontSize>
            <color>${crystalText}</color>
            <letterCase>uppercase</letterCase>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>50</zIndex>
        </text>
        <text name="factsLine">
            <pos>0.030 0.535</pos>
            <size>0.20 0.04</size>
            <origin>0 0</origin>
            <fontSize>0.017</fontSize>
            <color>${crystalAccent}</color>
            <letterCase>uppercase</letterCase>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>50</zIndex>
        </text>

        <!-- Crystal carousel stage: a glossy deep-blue floor that seats the
             carousel. v3.6.0: rebuilt as a real stage — royal-blue to
             deep-navy gradient, bright horizon highlight, halftone fading
             with depth, and a baked horizontal edge falloff so the outer
             cards recede.
             v4.0.0: taller stage for the bigger cards; the baked spotlight
             is recentered on the v4 selected slot (screen x 0.5, y 0.85). -->
        <image name="carouselStage">
            <pos>0 1</pos>
            <size>1 0.340</size>
            <origin>0 1</origin>
            <path>./art/carousel_vignette.png</path>
            <zIndex>40</zIndex>
        </image>

        <!-- Crystal v4.0.0 carousel rebuild. v3.x lessons, learned the hard
             way on the Nova:
             - The device renders the design faithfully: v3 cards were
               118x154px because itemSize was 0.092x0.160. v4 cards are
               166x206 (+41% unfocused, +32% selected).
             - ES-DE 3.4.1 scissor-clips carousel children to the carousel
               rect (CarouselComponent::render pushClipRect). The v3
               selected card (1.33x + 19px lift) overflowed the top by ~36px
               and was visibly sliced on device. v4 geometry is verified
               against the engine's own layout math: yOff=41px >= 36px of
               selected overflow. Proof mocks now simulate the scissor rect.
             - 3.4.1's ImageComponent has no GIF/animation support and the
               carousel hard-creates ImageComponents (no itemTemplate), so
               the strip cannot animate on this ES-DE version. v4 uses the
               static trading cards; the animated posters are parked for a
               future <animation>-element showcase.
             Geometry at 1280x960: item 166x206, selected 208x258, 10px
             lift, 7 items, reflections off (their 2x-height reservation
             would force a half-screen zone and eat the hero). Pop, lift,
             saturation, dimming and margins still animate per-frame while
             scrolling, which is what makes it feel physical. -->
        <carousel name="sysCarousel">
            <type>horizontal</type>
            <pos>0 0.700</pos>
            <size>1 0.300</size>
            <origin>0 0</origin>
            <!-- The carousel paints its own background rect with this color
                 ABOVE the vignette stage (z45 > z40). Transparent lets the
                 stage show through. -->
            <color>00000000</color>
            <staticImage>./cards/${system.name}.png</staticImage>
            <defaultImage>./cards/_default.png</defaultImage>
            <itemSize>0.130 0.215</itemSize>
            <itemScale>1.25</itemScale>
            <maxItemCount>7</maxItemCount>
            <itemStacking>ascendingRaised</itemStacking>
            <selectedItemOffset>0 -0.010</selectedItemOffset>
            <selectedItemMargins>0.010 0.010</selectedItemMargins>
            <reflections>false</reflections>
            <imageCornerRadius>0.008</imageCornerRadius>
            <unfocusedItemOpacity>0.90</unfocusedItemOpacity>
            <unfocusedItemSaturation>0.55</unfocusedItemSaturation>
            <unfocusedItemDimming>0.18</unfocusedItemDimming>
            <imageInterpolation>linear</imageInterpolation>
            <itemTransitions>animate</itemTransitions>
            <fastScrolling>true</fastScrolling>
            <zIndex>45</zIndex>
        </carousel>

        <helpsystem name="sysHelp">
            <pos>0.5 0.982</pos>
            <origin>0.5 0.5</origin>
            <textColor>${crystalDim}</textColor>
            <iconColor>${crystalAccent}</iconColor>
            <fontSize>0.0145</fontSize>
        </helpsystem>
    </view>

    <!-- Crystal v3 gamelist view: same comic canvas, deep-blue wash for
         readability, console card top-right, metadata column. -->
    <view name="gamelist">
        <image name="gameBackground">
            <pos>0 0</pos>
            <size>1 1</size>
            <origin>0 0</origin>
            <path>./backgrounds/${system.name}.webp</path>
            <default>./backgrounds/_default.webp</default>
            <color>${crystalGameBg}</color>
            <zIndex>1</zIndex>
        </image>
        <image name="gameArt">
            <pos>0.80 0.14</pos>
            <size>0.30 0.335</size>
            <origin>0.5 0.5</origin>
            <path>./cards/${system.name}.png</path>
            <default>./cards/_default.png</default>
            <zIndex>20</zIndex>
        </image>
        <text name="gameName">
            <pos>0.06 0.055</pos>
            <size>0.50 0.06</size>
            <origin>0 0</origin>
            <metadata>name</metadata>
            <fontSize>0.032</fontSize>
            <color>${crystalAccent}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>30</zIndex>
        </text>
        <textlist name="gameList">
            <pos>0.06 0.14</pos>
            <size>0.44 0.72</size>
            <origin>0 0</origin>
            <primaryColor>${crystalText}</primaryColor>
            <secondaryColor>${crystalDim}</secondaryColor>
            <selectedColor>${crystalAccent}</selectedColor>
            <selectorColor>${crystalSelect}</selectorColor>
            <fontSize>0.024</fontSize>
            <horizontalMargin>0.012</horizontalMargin>
            <zIndex>30</zIndex>
        </textlist>
        <text name="devLabel">
            <pos>0.62 0.36</pos>
            <size>0.10 0.04</size>
            <origin>0 0</origin>
            <text>DEVELOPER</text>
            <fontSize>0.016</fontSize>
            <color>${crystalAccent}</color>
            <letterCase>uppercase</letterCase>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>30</zIndex>
        </text>
        <text name="devValue">
            <pos>0.74 0.36</pos>
            <size>0.22 0.04</size>
            <origin>0 0</origin>
            <metadata>developer</metadata>
            <fontSize>0.016</fontSize>
            <color>${crystalText}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>30</zIndex>
        </text>
        <text name="genreLabel">
            <pos>0.62 0.42</pos>
            <size>0.10 0.04</size>
            <origin>0 0</origin>
            <text>GENRE</text>
            <fontSize>0.016</fontSize>
            <color>${crystalAccent}</color>
            <letterCase>uppercase</letterCase>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>30</zIndex>
        </text>
        <text name="genreValue">
            <pos>0.74 0.42</pos>
            <size>0.22 0.04</size>
            <origin>0 0</origin>
            <metadata>genre</metadata>
            <fontSize>0.016</fontSize>
            <color>${crystalText}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>30</zIndex>
        </text>
        <text name="playersLabel">
            <pos>0.62 0.48</pos>
            <size>0.10 0.04</size>
            <origin>0 0</origin>
            <text>PLAYERS</text>
            <fontSize>0.016</fontSize>
            <color>${crystalAccent}</color>
            <letterCase>uppercase</letterCase>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>30</zIndex>
        </text>
        <text name="playersValue">
            <pos>0.74 0.48</pos>
            <size>0.22 0.04</size>
            <origin>0 0</origin>
            <metadata>players</metadata>
            <fontSize>0.016</fontSize>
            <color>${crystalText}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>30</zIndex>
        </text>
        <text name="gameDesc">
            <pos>0.62 0.56</pos>
            <size>0.32 0.28</size>
            <origin>0 0</origin>
            <metadata>description</metadata>
            <fontSize>0.015</fontSize>
            <color>${crystalDim}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>30</zIndex>
        </text>
        <helpsystem name="help">
            <pos>0.5 0.982</pos>
            <origin>0.5 0.5</origin>
            <textColor>${crystalDim}</textColor>
            <iconColor>${crystalAccent}</iconColor>
            <fontSize>0.0145</fontSize>
        </helpsystem>
    </view>
</theme>
