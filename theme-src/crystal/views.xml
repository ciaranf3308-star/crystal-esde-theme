            <itemScale>2.8889</itemScale>
            <maxItemCount>3.0</maxItemCount>
            <itemsBeforeCenter>1</itemsBeforeCenter>
            <itemsAfterCenter>1</itemsAfterCenter>
            <itemHorizontalAlignment>center</itemHorizontalAlignment>
            <reflections>false</reflections>
            <unfocusedItemOpacity>0.75</unfocusedItemOpacity>
            <unfocusedItemSaturation>0.8</unfocusedItemSaturation>
            <unfocusedItemDimming>0.25</unfocusedItemDimming>
            <imageInterpolation>linear</imageInterpolation>
            <itemTransitions>animate</itemTransitions>
            <fastScrolling>true</fastScrolling>
            <zIndex>50</zIndex>
        </carousel>

        <!-- 11. TITLE beneath the hero: yellow rule at 716, 28px uppercase
