        <text name="devLabel">
            <pos>0.0375 0.5792</pos>
            <size>0.09 0.024</size>
            <origin>0 0</origin>
            <text>DEVELOPER</text>
            <fontSize>0.0115</fontSize>
            <color>${crystalDim}</color>
            <letterCase>uppercase</letterCase>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>10</zIndex>
        </text>
        <text name="devValue">
            <pos>0.2563 0.5792</pos>
            <size>0.1263 0.024</size>
            <origin>1 0</origin>
            <metadata>developer</metadata>
            <fontSize>0.0188</fontSize>
            <color>${crystalText}</color>
            <horizontalAlignment>right</horizontalAlignment>
            <zIndex>10</zIndex>
        </text>

        <text name="ratingLabel">
            <pos>0.0375 0.6542</pos>
            <size>0.09 0.024</size>
            <origin>0 0</origin>
            <text>RATING</text>
            <fontSize>0.0115</fontSize>
            <color>${crystalDim}</color>
            <letterCase>uppercase</letterCase>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>10</zIndex>
        </text>
        <rating name="panelRating">
            <pos>0.0375 0.6833</pos>
            <size>0.14 0.04</size>
            <origin>0 0</origin>
            <filledPath>./art/star_filled.png</filledPath>
            <unfilledPath>./art/star_unfilled.png</unfilledPath>
            <zIndex>10</zIndex>
        </rating>

        <text name="panelCount">
            <pos>0.0375 0.7521</pos>
            <size>0.15 0.07</size>
            <origin>0 0</origin>
            <systemdata>gamecountGamesNoText</systemdata>
            <fontSize>0.0583</fontSize>
            <color>${crystalText}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>10</zIndex>
        </text>
        <text name="panelCountLabel">
            <pos>0.0375 0.8208</pos>
            <size>0.15 0.024</size>
            <origin>0 0</origin>
            <text>GAMES IN LIBRARY</text>
            <fontSize>0.0125</fontSize>
            <color>${crystalAccent}</color>
            <letterCase>uppercase</letterCase>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>10</zIndex>
        </text>

        <!-- Marquee: scraped logo art over a smaller styled title fallback
             (fallback stays smaller than typical marquee art: no ghosting). -->
        <text name="marqueeFallback">
            <pos>0.3281 0.09</pos>
            <size>0.4375 0.226</size>
            <origin>0 0</origin>
            <metadata>name</metadata>
            <fontSize>0.036</fontSize>
            <color>${crystalText}</color>
            <horizontalAlignment>center</horizontalAlignment>
            <zIndex>20</zIndex>
        </text>
        <image name="marqueeImg">
            <pos>0.5469 0.20</pos>
            <maxSize>0.42 0.20</maxSize>
            <origin>0.5 0.5</origin>
            <imageType>marquee</imageType>
            <zIndex>21</zIndex>
        </image>

        <!-- Physical-media hero: the collectible object, angled. -->
        <image name="mediaHero">
            <pos>0.8164 0.4635</pos>
            <maxSize>0.28 0.36</maxSize>
            <origin>0.5 0.5</origin>
            <imageType>physicalmedia 3dbox cover</imageType>
            <default>./media_fallbacks/${system.name}.png</default>
            <rotation>-8</rotation>
            <zIndex>25</zIndex>
        </image>

        <!-- The primary: physical media of every game, horizontal carousel.
             Selected item renders larger and vivid; neighbours dim and
             desaturate per-frame (same on/off language as the system view).
             Note: stock ES-DE 3.4.1 draws carousel captions only when an
             item has no image, so per-neighbour titles under media are not
             available; the selected title lives in the panel and marquee. -->
        <carousel name="gameCarousel">
            <type>horizontal</type>
            <pos>0.2938 0.675</pos>
            <size>0.7063 0.2917</size>
            <origin>0 0</origin>
            <imageType>physicalmedia 3dbox</imageType>
            <defaultImage>./media_fallbacks/${system.name}.png</defaultImage>
            <itemSize>0.095 0.11</itemSize>
            <itemScale>1.35</itemScale>
            <maxItemCount>7</maxItemCount>
            <unfocusedItemDimming>0.35</unfocusedItemDimming>
            <unfocusedItemSaturation>0.5</unfocusedItemSaturation>
            <unfocusedItemOpacity>0.9</unfocusedItemOpacity>
            <textColor>${crystalText}</textColor>
            <textSelectedColor>${crystalAccent}</textSelectedColor>
            <textBackgroundColor>0A2FA0E6</textBackgroundColor>
            <fastScrolling>true</fastScrolling>
            <zIndex>50</zIndex>
        </carousel>

        <!-- Footer prompt row, lightweight and integrated. -->
        <text name="footKeyA">
            <pos>0.7914 0.9688</pos>
            <origin>0 0.5</origin>
            <text>A</text>
            <fontSize>0.0146</fontSize>
            <color>${crystalAccent}</color>
            <zIndex>60</zIndex>
        </text>
        <text name="footWordA">
            <pos>0.8063 0.9688</pos>
            <origin>0 0.5</origin>
            <text>Select</text>
            <fontSize>0.0146</fontSize>
            <color>${crystalDim}</color>
            <zIndex>60</zIndex>
        </text>
        <text name="footKeyB">
            <pos>0.8641 0.9688</pos>
            <origin>0 0.5</origin>
            <text>B</text>
            <fontSize>0.0146</fontSize>
            <color>${crystalAccent}</color>
            <zIndex>60</zIndex>
        </text>
        <text name="footWordB">
            <pos>0.8789 0.9688</pos>
            <origin>0 0.5</origin>
            <text>Back</text>
            <fontSize>0.0146</fontSize>
            <color>${crystalDim}</color>
            <zIndex>60</zIndex>
        </text>
        <text name="footKeyY">
            <pos>0.9258 0.9688</pos>
            <origin>0 0.5</origin>
            <text>Y</text>
            <fontSize>0.0146</fontSize>
            <color>${crystalAccent}</color>
            <zIndex>60</zIndex>
        </text>
        <text name="footWordY">
            <pos>0.9406 0.9688</pos>
            <origin>0 0.5</origin>
            <text>Options</text>
            <fontSize>0.0146</fontSize>
            <color>${crystalDim}</color>
            <zIndex>60</zIndex>
        </text>
    </view>
</theme>
