             No panel; the background stays visible through it. -->
        <image name="libBottomGradient">
            <pos>0 0.71875</pos>
            <size>1 0.28125</size>
            <origin>0 0</origin>
            <path>./art/lib_bottom_gradient.png</path>
            <zIndex>2</zIndex>
        </image>

