<?xml version="1.0" encoding="UTF-8"?>
<theme>
    <!-- Crystal v1 shared view layout (new ES-DE theme engine: system + gamelist views).
         Per-system asset paths resolve via ${system.name}; missing files fall back
         gracefully (debug log only) to the <default> artwork. -->

    <!-- ================= SYSTEM VIEW ================= -->
    <view name="system">
        <image name="sysBackground">
            <pos>0 0</pos>
            <size>1 1</size>
            <path>./backgrounds/dark/${system.name}.webp</path>
            <default>./backgrounds/dark/_default.webp</default>
            <zIndex>1</zIndex>
        </image>

        <image name="sysLogo">
            <pos>0.5 0.06</pos>
            <origin>0.5 0</origin>
            <maxSize>0.5 0.3</maxSize>
            <path>./logos/dark/${system.name}.png</path>
            <zIndex>20</zIndex>
        </image>

        <text name="sysName">
            <pos>0.5 0.39</pos>
            <origin>0.5 0</origin>
            <size>0.9 0</size>
            <systemdata>fullname</systemdata>
            <fontSize>0.04</fontSize>
            <color>${crystalText}</color>
            <horizontalAlignment>center</horizontalAlignment>
            <zIndex>40</zIndex>
        </text>

        <text name="sysCount">
            <pos>0.5 0.525</pos>
            <origin>0.5 0</origin>
            <size>0.9 0</size>
            <systemdata>gamecountGames</systemdata>
            <fontSize>0.022</fontSize>
            <color>${crystalDim}</color>
            <horizontalAlignment>center</horizontalAlignment>
            <zIndex>40</zIndex>
        </text>

        <carousel name="sysCarousel">
            <pos>0 0.58</pos>
            <size>1 0.3</size>
            <type>horizontal</type>
            <staticImage>./carousel-icons/${system.name}.webp</staticImage>
            <defaultImage>./carousel-icons/auto-allgames.webp</defaultImage>
            <maxItemCount>5</maxItemCount>
            <itemSize>0.16 0.16</itemSize>
            <itemScale>1.45</itemScale>
            <imageFit>contain</imageFit>
            <color>00000000</color>
            <unfocusedItemOpacity>0.45</unfocusedItemOpacity>
            <unfocusedItemSaturation>0.7</unfocusedItemSaturation>
            <fastScrolling>true</fastScrolling>
            <zIndex>50</zIndex>
        </carousel>

        <!-- Small yellow focus accent under the carousel's selected item. -->
        <image name="focusBar">
            <pos>0.5 0.915</pos>
            <origin>0.5 0.5</origin>
            <size>0.09 0.006</size>
            <path>./ui/focus-bar.png</path>
            <zIndex>55</zIndex>
        </image>

        <helpsystem name="sysHelp">
            <pos>0.5 0.982</pos>
            <origin>0.5 1</origin>
            <fontSize>0.02</fontSize>
            <textColor>${crystalDim}</textColor>
            <iconColor>${crystalCyan}</iconColor>
        </helpsystem>
    </view>

    <!-- ================= GAMELIST VIEW ================= -->
    <view name="gamelist">
        <image name="gameBackground">
            <pos>0 0</pos>
            <size>1 1</size>
            <path>./backgrounds/dark/${system.name}.webp</path>
            <default>./backgrounds/dark/_default.webp</default>
            <color>AAAAAAFF</color>
            <zIndex>1</zIndex>
        </image>

        <textlist name="gamelist">
            <pos>0.045 0.13</pos>
            <size>0.4 0.78</size>
            <fontSize>0.03</fontSize>
            <lineSpacing>1.4</lineSpacing>
            <horizontalAlignment>left</horizontalAlignment>
            <primaryColor>${crystalText}</primaryColor>
            <secondaryColor>${crystalDim}</secondaryColor>
            <selectedColor>${crystalYellow}</selectedColor>
            <selectorColor>22D3EE2E</selectorColor>
            <textHorizontalScrolling>true</textHorizontalScrolling>
            <zIndex>50</zIndex>
        </textlist>

        <text name="gameName">
            <pos>0.51 0.13</pos>
            <size>0.445 0</size>
            <metadata>name</metadata>
            <fontSize>0.038</fontSize>
            <color>${crystalYellow}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>40</zIndex>
        </text>

        <image name="gameArt">
            <pos>0.51 0.2</pos>
            <maxSize>0.445 0.3</maxSize>
            <imageType>miximage</imageType>
            <default>./logos/dark/${system.name}.png</default>
            <cornerRadius>0.004</cornerRadius>
            <zIndex>30</zIndex>
        </image>

        <text name="lblDeveloper">
            <pos>0.51 0.525</pos>
            <size>0.445 0</size>
            <text>Developer</text>
            <fontSize>0.016</fontSize>
            <color>${crystalCyan}</color>
            <letterCase>uppercase</letterCase>
            <zIndex>40</zIndex>
        </text>
        <text name="valDeveloper">
            <pos>0.51 0.548</pos>
            <size>0.445 0</size>
            <metadata>developer</metadata>
            <defaultValue>:space:</defaultValue>
            <fontSize>0.022</fontSize>
            <color>${crystalText}</color>
            <zIndex>40</zIndex>
        </text>

        <text name="lblGenre">
            <pos>0.51 0.585</pos>
            <size>0.445 0</size>
            <text>Genre</text>
            <fontSize>0.016</fontSize>
            <color>${crystalCyan}</color>
            <letterCase>uppercase</letterCase>
            <zIndex>40</zIndex>
        </text>
        <text name="valGenre">
            <pos>0.51 0.608</pos>
            <size>0.445 0</size>
            <metadata>genre</metadata>
            <defaultValue>:space:</defaultValue>
            <fontSize>0.022</fontSize>
            <color>${crystalText}</color>
            <zIndex>40</zIndex>
        </text>

        <text name="lblPlayers">
            <pos>0.51 0.645</pos>
            <size>0.445 0</size>
            <text>Players</text>
            <fontSize>0.016</fontSize>
            <color>${crystalCyan}</color>
            <letterCase>uppercase</letterCase>
            <zIndex>40</zIndex>
        </text>
        <text name="valPlayers">
            <pos>0.51 0.668</pos>
            <size>0.445 0</size>
            <metadata>players</metadata>
            <defaultValue>:space:</defaultValue>
            <fontSize>0.022</fontSize>
            <color>${crystalText}</color>
            <zIndex>40</zIndex>
        </text>

        <text name="gameDesc">
            <pos>0.51 0.705</pos>
            <size>0.445 0.2</size>
            <metadata>description</metadata>
            <fontSize>0.02</fontSize>
            <color>${crystalDesc}</color>
            <zIndex>40</zIndex>
        </text>

        <helpsystem name="gameHelp">
            <pos>0.5 0.982</pos>
            <origin>0.5 1</origin>
            <fontSize>0.02</fontSize>
            <textColor>${crystalDim}</textColor>
            <iconColor>${crystalCyan}</iconColor>
        </helpsystem>
    </view>
</theme>
