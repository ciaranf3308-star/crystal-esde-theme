<?xml version="1.0" encoding="UTF-8"?>
<theme>
    <!-- Crystal v3 system view: the hero composition.
         - Baked comic background with the blue info panel at
           x 0.010..0.200, y 0.172..0.707 (measured on the 1920x1080 canvas).
         - Live text inside the panel: manufacturer badge, system name,
           description, game count, facts line.
         - Horizontal carousel of per-system hardware cards across the
           lower third (y 0.727..0.875). -->
    <view name="system">
        <image name="sysBackground">
            <pos>0 0</pos>
            <size>1 1</size>
            <origin>0 0</origin>
            <path>./backgrounds/${system.name}.webp</path>
            <default>./backgrounds/_default.webp</default>
            <zIndex>1</zIndex>
        </image>

        <text name="mfrBadge">
            <pos>0.028 0.205</pos>
            <size>0.16 0</size>
            <origin>0 0</origin>
            <fontSize>0.016</fontSize>
            <color>${crystalDim}</color>
            <letterCase>uppercase</letterCase>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>50</zIndex>
        </text>
        <text name="sysName">
            <pos>0.028 0.232</pos>
            <size>0.22 0.05</size>
            <origin>0 0</origin>
            <systemdata>fullname</systemdata>
            <fontSize>0.030</fontSize>
            <color>${crystalText}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>50</zIndex>
        </text>
        <text name="sysDesc">
            <pos>0.028 0.300</pos>
            <size>0.155 0.160</size>
            <origin>0 0</origin>
            <fontSize>0.0155</fontSize>
            <color>${crystalDim}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>50</zIndex>
        </text>
        <text name="countNum">
            <pos>0.028 0.475</pos>
            <size>0.16 0.06</size>
            <origin>0 0</origin>
            <systemdata>gamecountGames</systemdata>
            <fontSize>0.042</fontSize>
            <color>${crystalText}</color>
            <letterCase>uppercase</letterCase>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>50</zIndex>
        </text>
        <text name="factsLine">
            <pos>0.028 0.545</pos>
            <size>0.16 0.04</size>
            <origin>0 0</origin>
            <fontSize>0.015</fontSize>
            <color>${crystalAccent}</color>
            <letterCase>uppercase</letterCase>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>50</zIndex>
        </text>

        <!-- Crystal carousel stage: a deep-blue floor vignette that seats the
             carousel and gives the item reflections something to fade into. -->
        <image name="carouselStage">
            <pos>0 1</pos>
            <origin>0 1</origin>
            <path>./art/carousel_vignette.png</path>
            <zIndex>40</zIndex>
        </image>

        <!-- Crystal v3.1 showpiece carousel.
             Horizontal, 7 cards: the selected card pops to 1.28x, lifts 19px
             and renders in full vivid color while neighbours recede along a
             progressive depth curve (itemLinearScale), desaturated to 0.55.
             Cards are solid (no ghost fading) with rounded corners, a soft
             mirror reflection each, and a breathing gap opened around the
             selected card (selectedItemMargins). Every one of these values
             animates smoothly per-frame while scrolling (scale, saturation,
             lift, gap), which is what makes it feel physical. -->
        <carousel name="sysCarousel">
            <type>horizontal</type>
            <pos>0 0.648</pos>
            <size>1 0.335</size>
            <origin>0 0</origin>
            <color>FFFFFFFF</color>
            <staticImage>./cards/${system.name}.png</staticImage>
            <defaultImage>./cards/_default.png</defaultImage>
            <itemSize>0.092 0.160</itemSize>
            <itemScale>1.28</itemScale>
            <itemLinearScale>-0.08 -0.08</itemLinearScale>
            <maxItemCount>7</maxItemCount>
            <itemStacking>ascendingRaised</itemStacking>
            <selectedItemOffset>0 -0.018</selectedItemOffset>
            <selectedItemMargins>0.010 0.010</selectedItemMargins>
            <reflections>true</reflections>
            <reflectionsOpacity>0.35</reflectionsOpacity>
            <reflectionsFalloff>2.5</reflectionsFalloff>
            <imageCornerRadius>0.008</imageCornerRadius>
            <unfocusedItemOpacity>0.90</unfocusedItemOpacity>
            <unfocusedItemSaturation>0.55</unfocusedItemSaturation>
            <imageInterpolation>linear</imageInterpolation>
            <itemTransitions>animate</itemTransitions>
            <fastScrolling>true</fastScrolling>
            <zIndex>45</zIndex>
        </carousel>

        <helpsystem name="sysHelp">
            <pos>0.5 0.982</pos>
            <origin>0.5 0.5</origin>
            <textColor>${crystalDim}</textColor>
            <iconColor>${crystalAccent}</iconColor>
            <fontSize>0.0145</fontSize>
        </helpsystem>
    </view>

    <!-- Crystal v3 gamelist view: same comic canvas, deep-blue wash for
         readability, console card top-right, metadata column. -->
    <view name="gamelist">
        <image name="gameBackground">
            <pos>0 0</pos>
            <size>1 1</size>
            <origin>0 0</origin>
            <path>./backgrounds/${system.name}.webp</path>
            <default>./backgrounds/_default.webp</default>
            <color>${crystalGameBg}</color>
            <zIndex>1</zIndex>
        </image>
        <image name="gameArt">
            <pos>0.80 0.14</pos>
            <size>0.30 0.335</size>
            <origin>0.5 0.5</origin>
            <path>./cards/${system.name}.png</path>
            <default>./cards/_default.png</default>
            <zIndex>20</zIndex>
        </image>
        <text name="gameName">
            <pos>0.06 0.055</pos>
            <size>0.50 0.06</size>
            <origin>0 0</origin>
            <metadata>name</metadata>
            <fontSize>0.032</fontSize>
            <color>${crystalAccent}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>30</zIndex>
        </text>
        <textlist name="gameList">
            <pos>0.06 0.14</pos>
            <size>0.44 0.72</size>
            <origin>0 0</origin>
            <primaryColor>${crystalText}</primaryColor>
            <secondaryColor>${crystalDim}</secondaryColor>
            <selectedColor>${crystalAccent}</selectedColor>
            <selectorColor>${crystalSelect}</selectorColor>
            <fontSize>0.024</fontSize>
            <horizontalMargin>0.012</horizontalMargin>
            <zIndex>30</zIndex>
        </textlist>
        <text name="devLabel">
            <pos>0.62 0.36</pos>
            <size>0.10 0.04</size>
            <origin>0 0</origin>
            <text>DEVELOPER</text>
            <fontSize>0.016</fontSize>
            <color>${crystalAccent}</color>
            <letterCase>uppercase</letterCase>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>30</zIndex>
        </text>
        <text name="devValue">
            <pos>0.74 0.36</pos>
            <size>0.22 0.04</size>
            <origin>0 0</origin>
            <metadata>developer</metadata>
            <fontSize>0.016</fontSize>
            <color>${crystalText}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>30</zIndex>
        </text>
        <text name="genreLabel">
            <pos>0.62 0.42</pos>
            <size>0.10 0.04</size>
            <origin>0 0</origin>
            <text>GENRE</text>
            <fontSize>0.016</fontSize>
            <color>${crystalAccent}</color>
            <letterCase>uppercase</letterCase>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>30</zIndex>
        </text>
        <text name="genreValue">
            <pos>0.74 0.42</pos>
            <size>0.22 0.04</size>
            <origin>0 0</origin>
            <metadata>genre</metadata>
            <fontSize>0.016</fontSize>
            <color>${crystalText}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>30</zIndex>
        </text>
        <text name="playersLabel">
            <pos>0.62 0.48</pos>
            <size>0.10 0.04</size>
            <origin>0 0</origin>
            <text>PLAYERS</text>
            <fontSize>0.016</fontSize>
            <color>${crystalAccent}</color>
            <letterCase>uppercase</letterCase>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>30</zIndex>
        </text>
        <text name="playersValue">
            <pos>0.74 0.48</pos>
            <size>0.22 0.04</size>
            <origin>0 0</origin>
            <metadata>players</metadata>
            <fontSize>0.016</fontSize>
            <color>${crystalText}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>30</zIndex>
        </text>
        <text name="gameDesc">
            <pos>0.62 0.56</pos>
            <size>0.32 0.28</size>
            <origin>0 0</origin>
            <metadata>description</metadata>
            <fontSize>0.015</fontSize>
            <color>${crystalDim}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>30</zIndex>
        </text>
        <helpsystem name="help">
            <pos>0.5 0.982</pos>
            <origin>0.5 0.5</origin>
            <textColor>${crystalDim}</textColor>
            <iconColor>${crystalAccent}</iconColor>
            <fontSize>0.0145</fontSize>
        </helpsystem>
    </view>
</theme>
