            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>10</zIndex>
        </text>
        <text name="timeValue">
            <pos>0.2563 0.3875</pos>
            <size>0.1263 0.024</size>
            <origin>1 0</origin>
            <metadata>playtime</metadata>
            <fontSize>0.0188</fontSize>
            <color>${crystalText}</color>
            <horizontalAlignment>right</horizontalAlignment>
            <zIndex>10</zIndex>
        </text>
        <text name="playersLabel">
            <pos>0.0375 0.4354</pos>
            <size>0.09 0.024</size>
            <origin>0 0</origin>
            <text>PLAYERS</text>
            <fontSize>0.0115</fontSize>
            <color>${crystalDim}</color>
            <letterCase>uppercase</letterCase>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>10</zIndex>
        </text>
        <text name="playersValue">
            <pos>0.2563 0.4354</pos>
            <size>0.1263 0.024</size>
            <origin>1 0</origin>
            <metadata>players</metadata>
            <fontSize>0.0188</fontSize>
            <color>${crystalText}</color>
            <horizontalAlignment>right</horizontalAlignment>
            <zIndex>10</zIndex>
        </text>
        <text name="genreLabel">
            <pos>0.0375 0.4833</pos>
            <size>0.09 0.024</size>
            <origin>0 0</origin>
            <text>GENRE</text>
            <fontSize>0.0115</fontSize>
            <color>${crystalDim}</color>
            <letterCase>uppercase</letterCase>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>10</zIndex>
        </text>
        <text name="genreValue">
            <pos>0.2563 0.4833</pos>
            <size>0.1263 0.024</size>
            <origin>1 0</origin>
            <metadata>genre</metadata>
            <fontSize>0.0188</fontSize>
            <color>${crystalText}</color>
            <horizontalAlignment>right</horizontalAlignment>
            <zIndex>10</zIndex>
        </text>
        <text name="releaseLabel">
            <pos>0.0375 0.5313</pos>
            <size>0.09 0.024</size>
            <origin>0 0</origin>
            <text>RELEASED</text>
            <fontSize>0.0115</fontSize>
            <color>${crystalDim}</color>
            <letterCase>uppercase</letterCase>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>10</zIndex>
        </text>
