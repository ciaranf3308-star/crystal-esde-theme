<?xml version="1.0" encoding="UTF-8"?>
<theme>
    <!-- Crystal v3.3 system view: 4:3 hero composition for the Nova (1280x960).
         - Baked 4:3 comic background with the blue info panel at
           x 0.013..0.28, y 0.17..0.97 (fractions of the 4:3 frame).
         - The 5 supplied heroes are rendered on their own, fullscreen.
         - Live text inside the panel: manufacturer badge, system name,
           description, game count, facts line.
         - v4.0.0: horizontal carousel of per-system hardware cards across
           the lower strip (y 0.70..1.00), much bigger cards, no clipping. -->
    <view name="system">
        <image name="sysBackground">
            <pos>0 0</pos>
            <size>1 1</size>
            <origin>0 0</origin>
            <path>./backgrounds/${system.name}.webp</path>
            <default>./backgrounds/_default.webp</default>
            <zIndex>1</zIndex>
        </image>

        <!-- v4.0.0: panel text rebuilt — bigger, real hierarchy. The v3 text
             was small and clustered in the top half of the tall panel
             (15px badge / 29px title / 15px dim description) and looked
             lost on the Nova. Now: 17px badge, 38px title, 18px
             description in white (was dim), 53px count, 16px yellow facts.
             Per-system theme.xml files carry the measured name sizes
             (DejaVu Sans Bold, 4:3 panel, box 0.24). -->
        <text name="mfrBadge">
            <pos>0.030 0.195</pos>
            <size>0.16 0</size>
            <origin>0 0</origin>
            <fontSize>0.018</fontSize>
            <color>0A2FA0</color>
            <backgroundColor>FFFFFFFF</backgroundColor>
            <backgroundCornerRadius>0.007</backgroundCornerRadius>
            <backgroundMargins>0.010 0.005</backgroundMargins>
            <letterCase>uppercase</letterCase>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>50</zIndex>
        </text>
        <text name="sysName">
            <pos>0.030 0.230</pos>
            <size>0.24 0.055</size>
            <origin>0 0</origin>
            <systemdata>fullname</systemdata>
            <fontSize>0.040</fontSize>
            <color>${crystalText}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>50</zIndex>
        </text>
        <text name="sysDesc">
            <pos>0.030 0.281</pos>
            <size>0.20 0.140</size>
            <origin>0 0</origin>
            <fontSize>0.019</fontSize>
            <color>${crystalText}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>50</zIndex>
        </text>
        <text name="countNum">
            <pos>0.030 0.354</pos>
            <size>0.20 0.07</size>
            <origin>0 0</origin>
            <systemdata>gamecountGames</systemdata>
            <fontSize>0.055</fontSize>
            <color>${crystalText}</color>
            <letterCase>uppercase</letterCase>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>50</zIndex>
        </text>
        <text name="factsLine">
            <pos>0.030 0.415</pos>
            <size>0.20 0.04</size>
            <origin>0 0</origin>
            <fontSize>0.017</fontSize>
            <color>${crystalAccent}</color>
            <letterCase>uppercase</letterCase>
            <horizontalAlignment>left</horizontalAlignment>
            <zIndex>50</zIndex>
        </text>

        <!-- Crystal v4.1.0: the glossy deep-blue carousel stage ("blue bar"
             under the carousel) was removed at the user's request. The
             carousel now floats directly over the system background. -->

        <!-- Crystal v4.0.0 carousel rebuild. v3.x lessons, learned the hard
             way on the Nova:
             - The device renders the design faithfully: v3 cards were
               118x154px because itemSize was 0.092x0.160. v4 cards are
               166x206 (+41% unfocused, +32% selected).
             - ES-DE 3.4.1 scissor-clips carousel children to the carousel
               rect (CarouselComponent::render pushClipRect). The v3
               selected card (1.33x + 19px lift) overflowed the top by ~36px
               and was visibly sliced on device. v4 geometry is verified
               against the engine's own layout math: yOff=41px >= 36px of
               selected overflow. Proof mocks now simulate the scissor rect.
             - 3.4.1's ImageComponent has no GIF/animation support and the
               carousel hard-creates ImageComponents (no itemTemplate), so
               the strip cannot animate on this ES-DE version. v4.1.0 uses
               static cards: the 7 systems with user-supplied posters show
               the vivid "on" poster (selected = vivid, neighbours dimmed
               by unfocusedItemSaturation/unfocusedItemDimming: the same
               on/off language, done per-frame); the other 14 keep the
               v3.6.0 trading cards. The animated GIFs stay parked in
               cards_anim/ for a future <animation>-element showcase.
             v4.3.0 "Spotlight": the cards are now black marquee boxes with
             the console name in hero-style white text (the user's art lives
             on as a faint dark texture inside the box). The selected item
             is 2x the unfocused size (itemScale 2.0), lifted, sitting in a
             soft radial glow (art/carousel_glow.png, z40) over a whisper
             bottom vignette (art/sys_vignette.png, z39) — shading, not a
             bar. Geometry at 1280x960: item 122x162, selected 243x324,
             7 items, reflections off. -->
        <!-- v4.3.0: bottom vignette — a soft dark bed under the carousel
             zone. Neutral black, max ~30% at the screen edge, feathered
             out well above the cards. It must never read as a bar. -->
        <image name="sysVignette">
            <pos>0 0.600</pos>
            <size>1 0.400</size>
            <origin>0 0</origin>
            <path>./art/sys_vignette.png</path>
            <zIndex>39</zIndex>
        </image>
        <!-- v4.3.0: spotlight glow behind the carousel's center. The
             selected item is always centered, so this reads as a glow
             around the selected card. -->
        <image name="carouselGlow">
            <pos>0.5 0.812</pos>
            <size>0.484 0.479</size>
            <origin>0.5 0.5</origin>
            <path>./art/carousel_glow.png</path>
            <zIndex>40</zIndex>
        </image>
        <!-- v4.4.0 "Select": the 7 systems with user-supplied posters
             (genesis, ps2, dreamcast, psx, megadrive, n64, gc) show the
             vivid supplied poster on the SELECTED card via a per-system
             <image name="selectedPoster"> overlay (z55, pixel-aligned to
             the 2x selected slot at 0.5 0.812). ES-DE 3.4.1 renders one
             texture per carousel entry, so selected-state art cannot live
             in the carousel itself. Unselected entries keep the generic
             black marquee cards below. -->
        <carousel name="sysCarousel">
            <type>horizontal</type>
            <pos>0 0.640</pos>
            <size>1 0.360</size>
            <origin>0 0</origin>
            <!-- The carousel paints its own background rect with this color.
                 Transparent so the system background shows through
                 (v4.1.0: the old vignette stage under the carousel is gone). -->
            <color>00000000</color>
            <staticImage>./cards/${system.name}.png</staticImage>
            <defaultImage>./cards/_default.png</defaultImage>
            <!-- v4.3.0: 2x selected. Unfocused 122x162 (0.095x0.169),
                 selected 243x324 — fits the 346px zone centered with
                 ~11px headroom, so the scissor rect never clips it. -->
            <itemSize>0.095 0.169</itemSize>
            <itemScale>2.0</itemScale>
            <maxItemCount>7</maxItemCount>
            <itemStacking>ascendingRaised</itemStacking>
            <selectedItemOffset>0 -0.008</selectedItemOffset>
            <selectedItemMargins>0.010 0.010</selectedItemMargins>
            <reflections>false</reflections>
            <imageCornerRadius>0.008</imageCornerRadius>
            <!-- v4.3.0: gentle recession — the black boxes stay black and
                 their names stay readable; the 2x scale + glow + full
                 brightness carry the selection, not heavy dimming. -->
            <unfocusedItemOpacity>0.92</unfocusedItemOpacity>
            <unfocusedItemSaturation>0.85</unfocusedItemSaturation>
            <unfocusedItemDimming>0.22</unfocusedItemDimming>
            <imageInterpolation>linear</imageInterpolation>
            <itemTransitions>animate</itemTransitions>
            <fastScrolling>true</fastScrolling>
            <zIndex>45</zIndex>
        </carousel>

        <helpsystem name="sysHelp">
            <pos>0.5 0.982</pos>
            <origin>0.5 0.5</origin>
            <textColor>${crystalDim}</textColor>
            <iconColor>${crystalAccent}</iconColor>
            <fontSize>0.0145</fontSize>
        </helpsystem>
    </view>

    <!-- Crystal gamelist v5.5.0 — measured against the user's example
         ("what I wanted"), which is to scale: bottoms ALWAYS flush,
         growth/scale moves UP, equal spacing. No wheel, no arc.
           top-left   scraped marquee, BIG, tilted -18° counterclockwise
                      (rises to the right, per the example), blue/white
                      filter via saturation 0.12 + B9C9FF tint; the game
                      title text sits behind as the fallback when no
                      marquee is scraped
           top-right  game metadata block (description + facts + rating),
                      scaled up ~1.45x — nothing tiny
           center     physical-media STRAIGHT row — selected disk 0.468h
                      with yellow outer glow, neighbours 0.223h, bottoms
                      flush at 0.81h, equal 0.40w spacing, centres at
                      0.10 / 0.50 / 0.90
           below disk console name/logo, centered, tucked under the row
         One generic background for all 21 consoles with the royal-blue
         wash baked in. Platform notes: carousel captions render ONLY
         for artless items, so neighbour names under art are impossible
         stock; marquee art is scraped per-game media (imageType
         marquee). ES-DE rotation: positive = clockwise, so the
         example's counterclockwise tilt is rotation -18. -->
    <view name="gamelist">
        <!-- Generic background, full-bleed. -->
        <image name="libBackground">
            <pos>0 0</pos>
            <size>1 1</size>
            <origin>0 0</origin>
            <path>./art/gamelist_generic_bg.png</path>
            <zIndex>1</zIndex>
        </image>

        <!-- Marquee fallback: the game's name, BIG. Visible only when
             no marquee art is scraped — the marquee image (z20) covers
             it when art exists. -->
        <text name="libMarqueeTitle">
            <pos>0.05 0.08</pos>
            <size>0.38 0.22</size>
            <origin>0 0</origin>
            <metadata>name</metadata>
            <fontSize>0.045</fontSize>
            <color>${crystalDeep}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>19</zIndex>
        </text>

        <!-- Scraped marquee: the game logo / name art. BIG, angled -18°,
             blue/white filter (desaturate + light-blue multiply). The
             separate wash overlay is gone — saturation+color IS the
             filter now, applied to the art itself. -->
        <image name="libMarquee">
            <pos>0.21 0.155</pos>
            <maxSize>0.36 0.24</maxSize>
            <origin>0.5 0.5</origin>
            <rotation>-18</rotation>
            <rotationOrigin>0.5 0.5</rotationOrigin>
            <imageType>marquee</imageType>
            <saturation>0.12</saturation>
            <color>B9C9FF</color>
            <zIndex>20</zIndex>
        </image>

        <!-- Soft white bed behind the metadata block: the generic
             background is busy top-right, so the text needs a calm
             patch to sit on. -->
        <image name="libMetaScrim">
            <pos>0.635 0.04</pos>
            <size>0.335 0.33</size>
            <origin>0 0</origin>
            <path>./art/meta_scrim.png</path>
            <zIndex>59</zIndex>
        </image>

        <!-- Game metadata block, top-right. Scaled up ~1.45x (v5.4.0):
             nothing tiny. -->
        <text name="libDesc">
            <pos>0.648 0.052</pos>
            <size>0.31 0.165</size>
            <origin>0 0</origin>
            <metadata>description</metadata>
            <fontSize>0.023</fontSize>
            <color>${crystalInkDim}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <verticalAlignment>top</verticalAlignment>
            <zIndex>60</zIndex>
        </text>
        <text name="libGenre">
            <pos>0.648 0.230</pos>
            <size>0.155 0.032</size>
            <origin>0 0.5</origin>
            <metadata>genre</metadata>
            <fontSize>0.024</fontSize>
            <color>${crystalInkDim}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>
        <text name="libSep1">
            <pos>0.806 0.230</pos>
            <size>0.02 0.032</size>
            <origin>0 0.5</origin>
            <text>•</text>
            <fontSize>0.024</fontSize>
            <color>${crystalInkDim}</color>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>
        <datetime name="libYear">
            <pos>0.826 0.230</pos>
            <size>0.06 0.032</size>
            <origin>0 0.5</origin>
            <metadata>releasedate</metadata>
            <format>%Y</format>
            <fontSize>0.024</fontSize>
            <color>${crystalInkDim}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </datetime>
        <text name="libDev">
            <pos>0.648 0.266</pos>
            <size>0.155 0.032</size>
            <origin>0 0.5</origin>
            <metadata>developer</metadata>
            <fontSize>0.024</fontSize>
            <color>${crystalInkDim}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>
        <text name="libSep2">
            <pos>0.806 0.266</pos>
            <size>0.02 0.032</size>
            <origin>0 0.5</origin>
            <text>•</text>
            <fontSize>0.024</fontSize>
            <color>${crystalInkDim}</color>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>
        <text name="libPlayers">
            <pos>0.826 0.266</pos>
            <size>0.10 0.032</size>
            <origin>0 0.5</origin>
            <metadata>players</metadata>
            <fontSize>0.024</fontSize>
            <color>${crystalInkDim}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>
        <rating name="libRating">
            <pos>0.648 0.312</pos>
            <size>0.24 0.042</size>
            <origin>0 0.5</origin>
            <filledPath>./art/star_filled.png</filledPath>
            <unfilledPath>./art/star_unfilled.png</unfilledPath>
            <zIndex>60</zIndex>
        </rating>

        <!-- Yellow outer glow behind the selected disk slot (example:
             "Selected Disk (Outer GLow Yellow)"). Static: the selected
             slot is always centered, so the glow never moves. Circular
             on the 4:3 screen (0.402w x 0.536h = ~515x515px) around the
             0.468h selected disk, centered at (0.5, 0.576) = the
             selected disk's center now the row sits bottom-flush. -->
        <image name="libSelectedGlow">
            <pos>0.5 0.576</pos>
            <size>0.402 0.536</size>
            <origin>0.5 0.5</origin>
            <path>./art/lib_glow_yellow.png</path>
            <zIndex>48</zIndex>
        </image>

        <!-- The primary: physical-media STRAIGHT row, exactly per the
             user's example. The example is to scale: bottoms ALWAYS
             flush, growth/scale moves UP, equal spacing.

             How (verified against CarouselComponent.h @ v3.4.1):
             type=horizontal lays items out on a straight line with
             equal spacing (itemSpacing.x spreads maxItemCount items
             across the box). itemVerticalAlignment=bottom anchors every
             item by its BOTTOM-center: yOff = size.y - itemSize.y and
             the item origin becomes (0.5, 1.0), so setScale() grows the
             selected disk UPWARD while every bottom stays glued to the
             box bottom. No wheel, no arc, no rotation.

             Measured from the example (paper = screen):
               neighbour disk diameter 0.223h -> itemSize 0.167 0.223
                 (0.167*1280 = 0.223*960 = 214px, square box)
               selected disk 0.468h -> itemScale 2.1 (449px)
               bottoms flush at 0.81h -> box 1 x 0.52 @ 0.5 0.55
                 (box spans 0.29-0.81, selected top at 0.342)
               centres at 0.10 / 0.50 / 0.90 -> maxItemCount 2.5
                 gives 512px = 0.40w equal spacing.
             Left/right navigate. -->
        <carousel name="gameCarousel">
            <type>horizontal</type>
            <pos>0.5 0.55</pos>
            <size>1 0.52</size>
            <origin>0.5 0.5</origin>
            <color>00000000</color>
            <!-- Physical media ONLY (2-type limit per CarouselComponent.h):
                 disk/cart/3D box on every entry including neighbours. -->
            <imageType>physicalmedia 3dbox</imageType>
            <defaultImage>./media_fallbacks/${system.name}.png</defaultImage>
            <itemSize>0.167 0.223</itemSize>
            <itemScale>2.1</itemScale>
            <maxItemCount>2.5</maxItemCount>
            <itemVerticalAlignment>bottom</itemVerticalAlignment>
            <reflections>false</reflections>
            <imageCornerRadius>0.008</imageCornerRadius>
            <unfocusedItemOpacity>0.9</unfocusedItemOpacity>
            <unfocusedItemSaturation>0.85</unfocusedItemSaturation>
            <unfocusedItemDimming>0.2</unfocusedItemDimming>
            <imageInterpolation>linear</imageInterpolation>
            <itemTransitions>animate</itemTransitions>
            <fastScrolling>true</fastScrolling>
            <zIndex>50</zIndex>
        </carousel>

        <!-- Console name, tucked under the disk row per the example
             (row bottoms flush at 0.81; name sits just below).
             Per-system overrides supply the logo image (or keep this
             text for the 5 systems without artwork yet). -->
        <text name="libConsoleName">
            <pos>0.5 0.865</pos>
            <size>0.70 0.06</size>
            <origin>0.5 0.5</origin>
            <fontSize>0.044</fontSize>
            <color>FFFFFF</color>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>

        <!-- Footer hints, all consoles: scaled up ~1.3x (v5.4.0), kept
             clear of the wider badges. -->
        <text name="footBadgeA">
            <pos>0.040 0.955</pos>
            <size>0.036 0.048</size>
            <origin>0.5 0.5</origin>
            <text>A</text>
            <fontSize>0.026</fontSize>
            <color>0A2FA0</color>
            <backgroundColor>FFFFFFFF</backgroundColor>
            <backgroundCornerRadius>0.5</backgroundCornerRadius>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>
        <text name="footWordA">
            <pos>0.066 0.955</pos>
            <origin>0 0.5</origin>
            <text>SELECT</text>
            <fontSize>0.021</fontSize>
            <color>FFFFFFFF</color>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>
        <text name="footBadgeB">
            <pos>0.170 0.955</pos>
            <size>0.036 0.048</size>
            <origin>0.5 0.5</origin>
            <text>B</text>
            <fontSize>0.026</fontSize>
            <color>0A2FA0</color>
            <backgroundColor>FFFFFFFF</backgroundColor>
            <backgroundCornerRadius>0.5</backgroundCornerRadius>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>
        <text name="footWordB">
            <pos>0.196 0.955</pos>
            <origin>0 0.5</origin>
            <text>BACK</text>
            <fontSize>0.021</fontSize>
            <color>FFFFFFFF</color>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>
        <text name="footBadgeY">
            <pos>0.274 0.955</pos>
            <size>0.036 0.048</size>
            <origin>0.5 0.5</origin>
            <text>Y</text>
            <fontSize>0.026</fontSize>
            <color>0A2FA0</color>
            <backgroundColor>FFFFFFFF</backgroundColor>
            <backgroundCornerRadius>0.5</backgroundCornerRadius>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>
        <text name="footWordY">
            <pos>0.300 0.955</pos>
            <origin>0 0.5</origin>
            <text>OPTIONS</text>
            <fontSize>0.021</fontSize>
            <color>FFFFFFFF</color>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>

    </view>
</theme>
