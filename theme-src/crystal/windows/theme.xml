<?xml version="1.0" encoding="UTF-8"?>
<theme>
    <!-- Crystal v2 per-system overrides for windows: explicit asset paths.
         Element names match views.xml so these merge cleanly over the shared
         layout; the includes keep this file standalone-safe. -->
    <include>./../variables.xml</include>
    <include>./../views.xml</include>
    <view name="system">
        <image name="sysBackground">
            <path>./../${crystalBgDir}/windows.webp</path>
        </image>
        <image name="sysLogo">
            <path>./../${crystalLogoDir}/windows.png</path>
        </image>
    </view>
    <view name="gamelist">
        <image name="gameBackground">
            <path>./../${crystalBgDir}/windows.webp</path>
        </image>
        <image name="gameArt">
            <default>./../${crystalLogoDir}/windows.png</default>
        </image>
    </view>
</theme>
