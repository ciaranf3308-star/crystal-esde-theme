<?xml version="1.0" encoding="UTF-8"?>
<theme>
    <!-- Crystal v4.0: 4:3 Nova layout. Text inherits the base panel
         positions from views.xml; only content and the measured name size
         are set here (DejaVu Sans Bold, title box 0.24). -->
    <include>./../variables.xml</include>
    <include>./../views.xml</include>
    <view name="system">
        <text name="mfrBadge">
            <text>NINTENDO</text>
        </text>
        <text name="sysName">
            <!-- measured with DejaVu Sans Bold: fullName fits one line on the 4:3 panel -->
            <fontSize>0.040</fontSize>
            <text>Game Boy</text>

        </text>
        <text name="sysDesc">
            <text>The brick that built handhelds. Tetris forever.</text>
        </text>
        <text name="factsLine">
            <text>8-BIT • HANDHELD • 1989</text>
        </text>
        <text name="sysDesc">
            <size>0.228 0.140</size>
        </text>
        <text name="countNum">
        </text>
    </view>
    <view name="gamelist">
        <!-- v5.3.0: supplied per-console logo replaces the temporary
             text label. The base text element is hidden; the logo is
             a separate image element so no element-type merge
             semantics are relied upon. -->
        <text name="libConsoleName">
            <visible>false</visible>
        </text>
        <image name="libConsoleLogo">
            <pos>0.5 0.86</pos>
            <maxSize>0.5 0.085</maxSize>
            <origin>0.5 0.5</origin>
            <path>./../art/console_logos/gb.png</path>
            <zIndex>60</zIndex>
        </image>
        <!-- This system's background has no baked footer; live hints. -->
        <text name="footBadgeA">
            <pos>0.047 0.955</pos>
            <size>0.030 0.040</size>
            <origin>0.5 0.5</origin>
            <text>A</text>
            <fontSize>0.020</fontSize>
            <color>0A2FA0</color>
            <backgroundColor>FFFFFFFF</backgroundColor>
            <backgroundCornerRadius>0.5</backgroundCornerRadius>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>
        <text name="footWordA">
            <pos>0.072 0.955</pos>
            <origin>0 0.5</origin>
            <text>SELECT</text>
            <fontSize>0.016</fontSize>
            <color>FFFFFFFF</color>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>
        <text name="footBadgeB">
            <pos>0.129 0.955</pos>
            <size>0.030 0.040</size>
            <origin>0.5 0.5</origin>
            <text>B</text>
            <fontSize>0.020</fontSize>
            <color>0A2FA0</color>
            <backgroundColor>FFFFFFFF</backgroundColor>
            <backgroundCornerRadius>0.5</backgroundCornerRadius>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>
        <text name="footWordB">
            <pos>0.154 0.955</pos>
            <origin>0 0.5</origin>
            <text>BACK</text>
            <fontSize>0.016</fontSize>
            <color>FFFFFFFF</color>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>
        <text name="footBadgeY">
            <pos>0.211 0.955</pos>
            <size>0.030 0.040</size>
            <origin>0.5 0.5</origin>
            <text>Y</text>
            <fontSize>0.020</fontSize>
            <color>0A2FA0</color>
            <backgroundColor>FFFFFFFF</backgroundColor>
            <backgroundCornerRadius>0.5</backgroundCornerRadius>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>
        <text name="footWordY">
            <pos>0.236 0.955</pos>
            <origin>0 0.5</origin>
            <text>OPTIONS</text>
            <fontSize>0.016</fontSize>
            <color>FFFFFFFF</color>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>
    </view>
</theme>
