<?xml version="1.0" encoding="UTF-8"?>
<theme>
    <!-- Crystal v4.0: 4:3 Nova layout. Text inherits the base panel
         positions from views.xml; only content and the measured name size
         are set here (DejaVu Sans Bold, title box 0.24). -->
    <include>./../variables.xml</include>
    <include>./../views.xml</include>
    <view name="system">
        <text name="mfrBadge">
            <text>SONY</text>
        </text>
        <text name="sysName">
            <!-- measured with DejaVu Sans Bold: fullName fits one line on the 4:3 panel -->
            <fontSize>0.040</fontSize>
            <text>PlayStation</text>

        </text>
        <text name="sysDesc">
            <text>Where 3D grew up. Crash, Spyro, Final Fantasy VII.</text>
        </text>
        <text name="factsLine">
            <text>32-BIT • 1995</text>
        </text>
        <!-- v4.4.0 "Select": the selected carousel card shows this
             system's vivid supplied poster, pixel-aligned over the 2x
             selected slot (center 0.5 0.812, size 0.19 0.338 = 243x324
             at 1280x960). ES-DE renders one texture per carousel entry,
             so the selected-state art lives here as a per-system image
             element (z55, above the z45 carousel) that follows the
             selected system. Unselected entries keep the generic black
             marquee cards from the carousel's staticImage. -->
        <image name="selectedPoster">
            <pos>0.5 0.812</pos>
            <size>0.19 0.338</size>
            <origin>0.5 0.5</origin>
            <path>./../art/poster_on/psx.png</path>
            <cornerRadius>0.008</cornerRadius>
            <zIndex>55</zIndex>
        </image>
    </view>
    <view name="gamelist">
        <!-- v5.3.0: supplied per-console logo replaces the temporary
             text label. The base text element is hidden; the logo is
             a separate image element so no element-type merge
             semantics are relied upon. -->
        <text name="libConsoleName">
            <visible>false</visible>
        </text>
        <image name="libConsoleLogo">
            <pos>0.5 0.86</pos>
            <maxSize>0.5 0.085</maxSize>
            <origin>0.5 0.5</origin>
            <path>./../art/console_logos/psx.png</path>
            <zIndex>60</zIndex>
        </image>
        <!-- This system's background has no baked footer; live hints. -->
        <text name="footBadgeA">
            <pos>0.047 0.955</pos>
            <size>0.030 0.040</size>
            <origin>0.5 0.5</origin>
            <text>A</text>
            <fontSize>0.020</fontSize>
            <color>0A2FA0</color>
            <backgroundColor>FFFFFFFF</backgroundColor>
            <backgroundCornerRadius>0.5</backgroundCornerRadius>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>
        <text name="footWordA">
            <pos>0.072 0.955</pos>
            <origin>0 0.5</origin>
            <text>SELECT</text>
            <fontSize>0.016</fontSize>
            <color>FFFFFFFF</color>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>
        <text name="footBadgeB">
            <pos>0.129 0.955</pos>
            <size>0.030 0.040</size>
            <origin>0.5 0.5</origin>
            <text>B</text>
            <fontSize>0.020</fontSize>
            <color>0A2FA0</color>
            <backgroundColor>FFFFFFFF</backgroundColor>
            <backgroundCornerRadius>0.5</backgroundCornerRadius>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>
        <text name="footWordB">
            <pos>0.154 0.955</pos>
            <origin>0 0.5</origin>
            <text>BACK</text>
            <fontSize>0.016</fontSize>
            <color>FFFFFFFF</color>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>
        <text name="footBadgeY">
            <pos>0.211 0.955</pos>
            <size>0.030 0.040</size>
            <origin>0.5 0.5</origin>
            <text>Y</text>
            <fontSize>0.020</fontSize>
            <color>0A2FA0</color>
            <backgroundColor>FFFFFFFF</backgroundColor>
            <backgroundCornerRadius>0.5</backgroundCornerRadius>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>
        <text name="footWordY">
            <pos>0.236 0.955</pos>
            <origin>0 0.5</origin>
            <text>OPTIONS</text>
            <fontSize>0.016</fontSize>
            <color>FFFFFFFF</color>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>
    </view>
</theme>
