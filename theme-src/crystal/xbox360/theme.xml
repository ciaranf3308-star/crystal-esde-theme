<?xml version="1.0" encoding="UTF-8"?>
<theme>
    <!-- Crystal v4.0: 4:3 Nova layout. Text inherits the base panel
         positions from views.xml; only content and the measured name size
         are set here (DejaVu Sans Bold, title box 0.24). -->
    <include>./../variables.xml</include>
    <include>./../views.xml</include>
    <view name="system">
        <text name="mfrBadge">
            <text>MICROSOFT</text>
        </text>
        <text name="sysName">
            <!-- measured with DejaVu Sans Bold: fullName fits one line on the 4:3 panel -->
            <fontSize>0.040</fontSize>
            <text>Xbox 360</text>

        </text>
        <text name="sysDesc">
            <text>HD-era pioneer. A legendary library.</text>
        </text>
        <text name="factsLine">
            <text>2005</text>
        </text>
    </view>
    <view name="gamelist">
        <!-- v5.0.0 skeleton: console name for the gamelist
             bottom-center slot (user supplies final logo names). -->
        <text name="libConsoleName">
            <text>Xbox 360</text>
        </text>
        <!-- This system's background has no baked footer; live hints. -->
    </view>
</theme>
