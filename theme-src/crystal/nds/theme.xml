<?xml version="1.0" encoding="UTF-8"?>
<theme>
    <!-- Crystal v1 per-system overrides for nds: explicit asset paths.
         Element names match views.xml so these merge cleanly over the shared
         layout; the includes keep this file standalone-safe. -->
    <include>./../variables.xml</include>
    <include>./../views.xml</include>
    <view name="system">
        <image name="sysBackground">
            <path>./../backgrounds/dark/nds.webp</path>
        </image>
        <image name="sysLogo">
            <path>./../logos/dark/nds.png</path>
        </image>
    </view>
    <view name="gamelist">
        <image name="gameBackground">
            <path>./../backgrounds/dark/nds.webp</path>
        </image>
        <image name="gameArt">
            <default>./../logos/dark/nds.png</default>
        </image>
    </view>
</theme>
